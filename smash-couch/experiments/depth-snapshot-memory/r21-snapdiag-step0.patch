+        // Diagnostics only: counts this snapshot's allocated bytes as resident until Dispose. Call once, before the
+        // snapshot is shared with a lease; snapshots that are never tracked (fixtures) are not counted.
+        internal void TrackResidency(ulong allocatedBytes)
+        {
+            if (Volatile.Read(ref _disposed) != 0 || Volatile.Read(ref _trackedSince) != 0) return;
+            _trackedBytes = (long)Math.Min(allocatedBytes, (ulong)(long.MaxValue / 4));
+            if (Interlocked.CompareExchange(ref _trackedSince, Stopwatch.GetTimestamp(), 0) != 0) return;
+            DepthSnapshotResidency.Add(_trackedBytes);
+        }
