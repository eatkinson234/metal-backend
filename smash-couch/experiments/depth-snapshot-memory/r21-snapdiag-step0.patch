@@ -0,0 +1,50 @@
+using System;
+using System.Threading;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // Diagnostics only (memory spike, FIX-PLAN step 0). Depth feedback snapshots still owned (created and not yet
+    // disposed, that is until their last command buffer completed) and their allocated bytes; the peak bytes and the
+    // longest residency since the timing summary last read them; retired count and summed residency, cumulative.
+    // Counts only; nothing here changes what is allocated, encoded or drawn.
+    internal static class DepthSnapshotResidency
+    {
+        private static long _residentCount, _residentBytes, _peakResidentBytes;
+        private static long _retiredCount, _retiredResidencyTicks, _maxResidencyTicks;
+
+        internal static void Add(long bytes)
+        {
+            Interlocked.Increment(ref _residentCount);
+            RaiseTo(ref _peakResidentBytes, Interlocked.Add(ref _residentBytes, bytes));
+        }
+
+        internal static void Retire(long bytes, long residencyTicks)
+        {
+            Interlocked.Decrement(ref _residentCount);
+            Interlocked.Add(ref _residentBytes, -bytes);
+            Interlocked.Increment(ref _retiredCount);
+            Interlocked.Add(ref _retiredResidencyTicks, residencyTicks);
+            RaiseTo(ref _maxResidencyTicks, residencyTicks);
+        }
+
+        // Resets the peak to the current resident bytes and the longest residency to zero, so both cover the time
+        // since the previous call (the timing writer calls it once per summary).
+        internal static (long ResidentCount, long ResidentBytes, long PeakResidentBytes, long RetiredCount,
+            long RetiredResidencyTicks, long MaxResidencyTicks) Read()
+        {
+            long resident = Interlocked.Read(ref _residentBytes);
+            long peak = Math.Max(resident, Interlocked.Exchange(ref _peakResidentBytes, resident));
+            return (Interlocked.Read(ref _residentCount), resident, peak, Interlocked.Read(ref _retiredCount),
+                Interlocked.Read(ref _retiredResidencyTicks), Interlocked.Exchange(ref _maxResidencyTicks, 0));
+        }
+
+        private static void RaiseTo(ref long target, long value)
+        {
+            long current;
+            while (value > (current = Interlocked.Read(ref target)) &&
+                   Interlocked.CompareExchange(ref target, value, current) != current)
+            {
+            }
+        }
+    }
+}
