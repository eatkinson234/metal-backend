@@ -0,0 +1,57 @@
+using Ryujinx.Common.Logging;
+using SharpMetal.Metal;
+using System;
+using System.IO;
+using System.Runtime.Versioning;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // Fable audit 3.5 experiment, off by default: MTLDevice.shouldMaximizeConcurrentCompilation lets Metal's compiler
+    // service run as many compilation tasks at once as it can, instead of its default pool. Set once on the new device,
+    // before any program or pipeline compiles. SMASH_COUCH_MAX_CONCURRENT_COMPILE=1 (rig A/B; when set it wins, anything
+    // else is off) or a file named max-concurrent-compile in the private data directory the launcher passes
+    // (SMASH_COUCH_PRIVATE_DATA) turns it on at the next game launch. One log line either way with the task count.
+    [SupportedOSPlatform("macos")]
+    static class ConcurrentCompilation
+    {
+        public const string FlagFileName = "max-concurrent-compile";
+
+        public static void Apply(MTLDevice device)
+        {
+            bool on = Read(Environment.GetEnvironmentVariable("SMASH_COUCH_MAX_CONCURRENT_COMPILE"),
+                Environment.GetEnvironmentVariable("SMASH_COUCH_PRIVATE_DATA"));
+            try
+            {
+                var before = device.MaximumConcurrentCompilationTaskCount;
+                if (on)
+                {
+                    device.ShouldMaximizeConcurrentCompilation = true;
+                }
+                Logger.Info?.Print(LogClass.Gpu, $"[MetalCompile] maximizeConcurrent={device.ShouldMaximizeConcurrentCompilation};" +
+                    $"requested={on};taskCount={before}->{device.MaximumConcurrentCompilationTaskCount}");
+            }
+            catch (Exception exception)
+            {
+                // Diagnostics and an optional hint only: never stop the renderer over them.
+                Logger.Warning?.Print(LogClass.Gpu, $"[MetalCompile] could not read or set concurrent compilation: {exception.Message}");
+            }
+        }
+
+        private static bool Read(string variable, string privateData)
+        {
+            if (!string.IsNullOrEmpty(variable))
+            {
+                return variable == "1";
+            }
+            try
+            {
+                return !string.IsNullOrEmpty(privateData) && Path.IsPathFullyQualified(privateData) &&
+                    File.Exists(Path.Combine(privateData, FlagFileName));
+            }
+            catch (Exception)
+            {
+                return false;
+            }
+        }
+    }
+}
