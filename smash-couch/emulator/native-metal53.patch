+        if (_token.Length != 16) throw new ArgumentException("Invalid couch session token");
+        if (timebaseNumer == 0 || timebaseDenom == 0) throw new ArgumentException("Invalid Darwin timebase");
+        _nowTicks = nowTicks ?? throw new ArgumentNullException(nameof(nowTicks));
+        _timebaseNumer = timebaseNumer;
+        _timebaseDenom = timebaseDenom;
+        _captureFreshnessTrace = captureFreshnessTrace;
+        // Install the shared bridge latch before the receiver thread can accept.
+        _diagnosticStopRequested = diagnosticStopRequested;
+        _sessionGeneration = captureFreshnessTrace ? unchecked((ulong)Interlocked.Increment(ref _nextSessionGeneration)) : 0;
+        _path = path;
+        // Never delete an existing endpoint: fail closed on collisions.
+        _socket = new Socket(AddressFamily.Unix, SocketType.Dgram, ProtocolType.Unspecified);
+        _socket.Bind(new UnixDomainSocketEndPoint(path));
+        File.SetUnixFileMode(path, UnixFileMode.UserRead | UnixFileMode.UserWrite);
+        _thread = new Thread(Receive) { IsBackground = true, Name = "Couch input receiver" };
+        _thread.Start();
+    }
+
+    private static (ulong Numer, ulong Denom) ReadDarwinTimebase()
+    {
+        if (MachTimebaseInfoNative(out MachTimebaseInfo info) != 0 || info.Numer == 0 || info.Denom == 0)
+            throw new InvalidOperationException("Unable to read Darwin mach timebase");
+        return (info.Numer, info.Denom);
+    }
+
+    internal static ulong ContinuousTime() => MachContinuousTimeNative();
+
+    // Used only by the local transport test to timestamp a datagram with the
+    // same Darwin clock as the receiver.
+    internal static ulong ContinuousTimeForTests() => ContinuousTime();
+    internal static (ulong Numer, ulong Denom) TimebaseForTests() => DarwinTimebase;
+
+    private bool IsFresh(ulong origin, ulong now)
+    {
+        if (origin == 0 || now < origin) return false;
+
+        // Convert without overflowing ulong: (now-origin)*numer <=
+        // 150,000,000ns*denom. UInt128 is available in the net9 target.
+        UInt128 elapsedNumerator = (UInt128)(now - origin) * _timebaseNumer;
+        UInt128 maximumNumerator = (UInt128)MaxAgeNanoseconds * _timebaseDenom;
+        return elapsedNumerator <= maximumNumerator;
+    }
+
+    private void Receive()
+    {
+        byte[] data = new byte[PacketBytes + 1];
+        while (!_stopping)
+        {
+            try
+            {
+                if (!_socket.Poll(100000, SelectMode.SelectRead)) continue;
+                int n = _socket.Receive(data);
+                Accept(data.AsSpan(0, n));
+            }
+            catch (SocketException) { if (_stopping) return; }
+            catch (ObjectDisposedException) { return; }
+        }
+    }
+
+    internal bool Accept(ReadOnlySpan<byte> packet)
+    {
+        if (packet.Length != PacketBytes ||
+            BinaryPrimitives.ReadUInt64LittleEndian(packet) != PacketMagicV2 ||
+            !packet.Slice(8, 16).SequenceEqual(_token)) return false;
+
+        ulong seq = BinaryPrimitives.ReadUInt64LittleEndian(packet.Slice(24));
+        ulong captureTime = BinaryPrimitives.ReadUInt64LittleEndian(packet.Slice(32));
+        // Validate at arrival so an old queued datagram cannot enter the latest
+        // snapshot. Read() repeats this check against the original timestamp.
+        if (!IsFresh(captureTime, _nowTicks())) return false;
+
+        for (int i = 0; i < 8; i++)
+        {
+            int at = PacketHeaderBytes + i * 32;
+            if (BinaryPrimitives.ReadUInt32LittleEndian(packet.Slice(at)) > 1) return false;
+            if ((BinaryPrimitives.ReadUInt32LittleEndian(packet.Slice(at + 4)) & ~0x1fffeU) != 0) return false;
+            for (int j = 0; j < 6; j++)
+            {
+                float value = BinaryPrimitives.ReadSingleLittleEndian(packet.Slice(at + 8 + j * 4));
+                if (!float.IsFinite(value) || Math.Abs(value) > 1 || (j >= 4 && value < 0)) return false;
+            }
+        }
+
+        lock (_gate)
+        {
+            if (_diagnosticCloseStopped || (_diagnosticStopRequested?.Invoke() ?? false)) return false;
+            // Recheck immediately before sequence/copy so acceptance
+            // linearizes only while the sender origin is still fresh.
+            ulong acceptedMachTicks = _nowTicks();
+            if (!IsFresh(captureTime, acceptedMachTicks)) return false;
+            if (_hasPacket && seq <= _sequence) return false;
+            packet.CopyTo(_latest);
+            _sequence = seq;
+            _captureTime = captureTime;
+            if (_captureFreshnessTrace)
+            {
+                _acceptedMachTicks = acceptedMachTicks;
+            }
+            _hasPacket = true;
+        }
+        return true;
+    }
+
+    internal (uint Buttons, float LX, float LY, float RX, float RY, float LT, float RT) Read(int slot)
+    {
+        CouchSlotRead snapshot = ReadSnapshot(slot, false);
+        return (snapshot.Buttons, snapshot.LX, snapshot.LY, snapshot.RX, snapshot.RY, snapshot.LT, snapshot.RT);
+    }
+
+    internal CouchSlotRead ReadSnapshot(int slot, bool includeFreshnessTrace)
+    {
+        if (slot < 0 || slot >= 8) return default;
+
+        bool trace = includeFreshnessTrace && _captureFreshnessTrace;
+        lock (_gate)
+        {
+            if (!_hasPacket || (_diagnosticStopRequested?.Invoke() ?? false))
+            {
+                if (!trace) return default;
+
+                ulong noPacketReadTicks = _nowTicks();
+                return new CouchSlotRead(default, CreateProvenance(
+                    NpadInputFreshnessReadStatus.NoPacket,
+                    slot,
+                    false,
+                    0,
+                    0,
+                    0,
+                    noPacketReadTicks,
+                    0));
+            }
+
+            ulong readMachTicks = _nowTicks();
+            NpadInputFreshnessReadStatus status = NpadInputFreshnessReadStatus.FreshEnabled;
+
+            // A dead/stalled launcher cannot leave buttons or sticks held. Age
+            // is measured from the sender's capture timestamp, never arrival.
+            if (!IsFresh(_captureTime, readMachTicks))
+            {
+                status = NpadInputFreshnessReadStatus.Stale;
+                return new CouchSlotRead(default, trace ? CreateProvenance(status, slot, true, _sequence, _captureTime, _acceptedMachTicks, readMachTicks, 0) : default);
+            }
+
+            ReadOnlySpan<byte> s = _latest.AsSpan(PacketHeaderBytes + slot * 32, 32);
+            if (BinaryPrimitives.ReadUInt32LittleEndian(s) == 0)
+            {
+                status = NpadInputFreshnessReadStatus.SlotDisabled;
+                return new CouchSlotRead(default, trace ? CreateProvenance(status, slot, true, _sequence, _captureTime, _acceptedMachTicks, readMachTicks, 0) : default);
+            }
+
+            var state = (BinaryPrimitives.ReadUInt32LittleEndian(s.Slice(4)), F(s, 8), F(s, 12), F(s, 16), F(s, 20), F(s, 24), F(s, 28));
+            NpadInputFreshnessProvenance provenance = trace
+                ? CreateProvenance(status, slot, true, _sequence, _captureTime, _acceptedMachTicks, readMachTicks, 0)
+                : default;
+            return new CouchSlotRead(state, provenance);
+        }
+    }
+
+    internal ulong ReadMappedMachTicks() => _nowTicks();
+
+    private NpadInputFreshnessProvenance CreateProvenance(
+        NpadInputFreshnessReadStatus status,
+        int slot,
+        bool hasPacket,
+        ulong sequence,
+        ulong captureMachTicks,
+        ulong acceptedMachTicks,
+        ulong readMachTicks,
+        ulong mappedMachTicks)
+    {
+        return new NpadInputFreshnessProvenance(
+            status,
+            slot,
+            _sessionGeneration,
+            hasPacket,
+            sequence,
+            captureMachTicks,
+            acceptedMachTicks,
+            readMachTicks,
+            mappedMachTicks,
+            _timebaseNumer,
+            _timebaseDenom);
+    }
+
+    private static float F(ReadOnlySpan<byte> s, int at) => BinaryPrimitives.ReadSingleLittleEndian(s.Slice(at));
+
+    // Diagnostic-only gate. Serialize with packet acceptance/read snapshots so
+    // no later datagram can restore held input, even if UI shutdown stalls.
+    internal void StopAndNeutralizeForDiagnosticClose()
+    {
+        lock (_gate)
+        {
+            _diagnosticCloseStopped = true;
+            _hasPacket = false;
+            Array.Clear(_latest);
+        }
+    }
+
+    public void Dispose()
+    {
+        _stopping = true;
+        _socket.Dispose();
+        _thread.Join(500);
+        try { File.Delete(_path); } catch (IOException) { }
+    }
+}
+
+internal readonly struct CouchSlotRead
+{
+    internal readonly uint Buttons;
+    internal readonly float LX;
+    internal readonly float LY;
+    internal readonly float RX;
+    internal readonly float RY;
+    internal readonly float LT;
+    internal readonly float RT;
+    internal readonly NpadInputFreshnessProvenance Provenance;
+
+    internal CouchSlotRead(
+        (uint Buttons, float LX, float LY, float RX, float RY, float LT, float RT) state,
+        NpadInputFreshnessProvenance provenance)
+    {
+        Buttons = state.Buttons;
+        LX = state.LX;
+        LY = state.LY;
+        RX = state.RX;
+        RY = state.RY;
+        LT = state.LT;
+        RT = state.RT;
+        Provenance = provenance;
+    }
+}
+
+internal static class CouchBridge
+{
+    private static int DiagnosticCloseStopRequested;
+    internal static bool Enabled => Environment.GetEnvironmentVariable("SMASH_COUCH_SOCKET") is { Length: > 0 };
+    private static readonly bool InputFreshnessTraceEnabledFromEnvironment =
+        Environment.GetEnvironmentVariable("SMASH_COUCH_INPUT_TRACE") == "1";
+    private static readonly string InputFreshnessTracePath = Environment.GetEnvironmentVariable("SMASH_COUCH_INPUT_TRACE_PATH");
+    private static readonly Lazy<InputFreshnessTraceRecorder> TraceRecorder = InputFreshnessTraceEnabledFromEnvironment
+        ? new Lazy<InputFreshnessTraceRecorder>(() => new InputFreshnessTraceRecorder(CouchReceiver.ContinuousTime))
+        : null;
+    private static readonly InputFreshnessTraceFinalizationWorker TraceFinalizer = InputFreshnessTraceEnabledFromEnvironment
+        ? new InputFreshnessTraceFinalizationWorker(
+            enabled: true,
+            finalPath: InputFreshnessTracePath,
+            recorderProvider: GetInitializedTraceRecorder)
+        : null;
+    private static readonly Lazy<CouchReceiver> Instance = new(() => CreateReceiver(null));
+
+    // Optional cold-path barrier for the deterministic CPU fixture. Production
+    // always passes null; this same factory supplies the ordinary Lazy instance.
+    internal static CouchReceiver CreateReceiver(Action<CouchReceiver> beforePublication)
+    {
+        CouchReceiver receiver = new(
+            Environment.GetEnvironmentVariable("SMASH_COUCH_SOCKET"),
+            Environment.GetEnvironmentVariable("SMASH_COUCH_TOKEN"),
+            CouchReceiver.ContinuousTime,
+            CouchReceiver.TimebaseForTests().Numer,
+            CouchReceiver.TimebaseForTests().Denom,
+            InputFreshnessTraceEnabledFromEnvironment,
+            () => Volatile.Read(ref DiagnosticCloseStopRequested) != 0);
+        try
+        {
+            beforePublication?.Invoke(receiver);
+            if (Volatile.Read(ref DiagnosticCloseStopRequested) != 0)
+                receiver.StopAndNeutralizeForDiagnosticClose();
+            return receiver;
+        }
+        catch
+        {
+            receiver.Dispose();
+            throw;
+        }
+    }
+
+    static CouchBridge()
+    {
+        if (InputFreshnessTraceEnabledFromEnvironment)
+        {
+            AppDomain.CurrentDomain.ProcessExit += ExportTraceOnExit;
+            InputTraceIdentityDiagnostics.ReportCouchBridgeArmed(
+                InputFreshnessTraceEnabledFromEnvironment,
+                InputFreshnessTracePath,
+                TraceRecorder?.IsValueCreated ?? false);
+        }
+    }
+
+    internal static CouchReceiver Receiver
+    {
+        get
+        {
+            CouchReceiver receiver = Instance.Value;
+            if (Volatile.Read(ref DiagnosticCloseStopRequested) != 0)
+                receiver.StopAndNeutralizeForDiagnosticClose();
+            return receiver;
+        }
+    }
+
+    internal static void StopAndNeutralizeForDiagnosticClose()
+    {
+        // Latch first even if Lazy is absent or still executing its factory.
+        // Accept/read consult the same latch before creation can publish state.
+        Interlocked.Exchange(ref DiagnosticCloseStopRequested, 1);
+        if (Instance.IsValueCreated) Instance.Value.StopAndNeutralizeForDiagnosticClose();
+    }
+
+    internal static InputFreshnessTraceFinalizationStatus InputFreshnessTraceStatus =>
+        TraceFinalizer?.Status ?? InputFreshnessTraceFinalizationStatus.Disabled;
+
+    internal static bool TryGetInputFreshnessTraceRecorder(out InputFreshnessTraceRecorder recorder)
+    {
+        recorder = null;
+        if (!InputFreshnessTraceEnabledFromEnvironment) return false;
+
+        try
+        {
+            recorder = TraceRecorder.Value;
+            return true;
+        }
+        catch
+        {
+            TraceFinalizer?.MarkInitializationFailed();
+            return false;
+        }
+    }
+
+    private static InputFreshnessTraceRecorder GetInitializedTraceRecorder()
+    {
+        return TraceRecorder?.IsValueCreated == true ? TraceRecorder.Value : null;
+    }
+
+    private static void ExportTraceOnExit(object sender, EventArgs args)
+    {
+        // The process-exit callback only starts the owned worker and waits for its bounded result.
+        // Serialization and file operations never run inline on this callback.
+        if (TraceFinalizer != null && !TraceFinalizer.RunProcessExitBounded())
+        {
+            TraceFinalizer.MarkProcessExitFailureObserved();
+        }
+    }
+}
diff --git a/src/Ryujinx.Input.SDL2/CouchGamepad.cs b/src/Ryujinx.Input.SDL2/CouchGamepad.cs
new file mode 100644
index 0000000000000000000000000000000000000000..3489417c764f5e2200fe08a8844934ae35c07b9d
--- /dev/null
+++ b/src/Ryujinx.Input.SDL2/CouchGamepad.cs
@@ -0,0 +1,178 @@
+using System;
+using System.Numerics;
+using Ryujinx.Common.Configuration.Hid;
+using Ryujinx.Common.Configuration.Hid.Controller;
+using Ryujinx.HLE.HOS.Services.Hid;
+using ConfigStick = Ryujinx.Common.Configuration.Hid.Controller.StickInputId;
+
+namespace Ryujinx.Input.SDL2;
+
+internal sealed class CouchGamepad : IGamepad, IInputFreshnessTraceProvider
+{
+    private readonly int _slot;
+    private readonly CouchReceiver _receiver;
+    private readonly InputFreshnessTraceRecorder _traceRecorder;
+    private StandardControllerInputConfig _config;
+    private readonly object _gate = new();
+    private float _threshold = .5f;
+
+    internal CouchGamepad(int slot)
+        : this(slot, CouchBridge.Receiver, GetTraceRecorder())
+    {
+    }
+
+    internal CouchGamepad(int slot, CouchReceiver receiver, InputFreshnessTraceRecorder traceRecorder = null)
+    {
+        _slot = slot;
+        _receiver = receiver ?? throw new ArgumentNullException(nameof(receiver));
+        _traceRecorder = traceRecorder;
+    }
+
+    private static InputFreshnessTraceRecorder GetTraceRecorder()
+    {
+        return CouchBridge.TryGetInputFreshnessTraceRecorder(out InputFreshnessTraceRecorder recorder) ? recorder : null;
+    }
+
+    public GamepadFeaturesFlag Features => GamepadFeaturesFlag.None;
+    public string Id => $"couch-{_slot + 1}";
+    public string Name => $"Couch Player {_slot + 1}";
+
+    // A reserved logical slot stays connected with neutral state during physical loss.
+    public bool IsConnected => true;
+
+    public bool InputFreshnessTraceEnabled => _traceRecorder != null && _receiver.CapturesFreshnessTrace;
+    public INpadInputFreshnessWriteObserver InputFreshnessWriteObserver => _traceRecorder;
+
+    public void Dispose() { }
+    public void SetLed(uint rgb) { }
+    public void Rumble(float low, float high, uint duration) { }
+    public Vector3 GetMotionData(MotionInputId id) => Vector3.Zero;
+    public void SetTriggerThreshold(float threshold) => _threshold = threshold;
+
+    public void SetConfiguration(InputConfig config)
+    {
+        lock (_gate)
+        {
+            _config = (StandardControllerInputConfig)config;
+            _threshold = _config.TriggerThreshold;
+        }
+    }
+
+    public GamepadStateSnapshot GetStateSnapshot()
+    {
+        CouchSlotRead snapshot = _receiver.ReadSnapshot(_slot, false);
+        return ToGamepadState(snapshot);
+    }
+
+    public bool IsPressed(GamepadButtonInputId id) => GetStateSnapshot().IsPressed(id);
+    public (float, float) GetStick(StickInputId id) => GetStateSnapshot().GetStick(id);
+
+    public GamepadStateSnapshot GetMappedStateSnapshot()
+    {
+        return GetMappedStateSnapshot(out _);
+    }
+
+    public GamepadStateSnapshot GetMappedStateSnapshot(out NpadInputFreshnessProvenance provenance)
+    {
+        bool trace = InputFreshnessTraceEnabled;
+        CouchSlotRead selected = _receiver.ReadSnapshot(_slot, trace);
+        GamepadStateSnapshot raw = ToGamepadState(selected);
+        GamepadStateSnapshot mapped = MapState(raw);
+
+        provenance = selected.Provenance;
+        if (trace && provenance.ReadStatus != NpadInputFreshnessReadStatus.NotTraced)
+        {
+            try
+            {
+                ulong mappedMachTicks = _receiver.ReadMappedMachTicks();
+                provenance = new NpadInputFreshnessProvenance(
+                    provenance.ReadStatus,
+                    provenance.LogicalSlot,
+                    provenance.SessionGeneration,
+                    provenance.HasPacket,
+                    provenance.Sequence,
+                    provenance.CaptureMachTicks,
+                    provenance.AcceptedMachTicks,
+                    provenance.ReadMachTicks,
+                    mappedMachTicks,
+                    provenance.TimebaseNumerator,
+                    provenance.TimebaseDenominator);
+            }
+            catch
+            {
+                // Preserve the mapped input even if optional timestamp capture fails.
+                _traceRecorder.MarkIncomplete();
+            }
+        }
+
+        return mapped;
+    }
+
+    private GamepadStateSnapshot MapState(GamepadStateSnapshot raw)
+    {
+        lock (_gate)
+        {
+            if (_config == null) return raw;
+
+            GamepadStateSnapshot result = default;
+            var left = _config.LeftJoycon;
+            var right = _config.RightJoycon;
+
+            void Map(GamepadButtonInputId to, GamepadInputId from)
+            {
+                if (from != GamepadInputId.Unbound)
+                {
+                    result.SetPressed(to, raw.IsPressed((GamepadButtonInputId)from));
+                }
+            }
+
+            Map(GamepadButtonInputId.A, right.ButtonA);
+            Map(GamepadButtonInputId.B, right.ButtonB);
+            Map(GamepadButtonInputId.X, right.ButtonX);
+            Map(GamepadButtonInputId.Y, right.ButtonY);
+            Map(GamepadButtonInputId.Plus, right.ButtonPlus);
+            Map(GamepadButtonInputId.Minus, left.ButtonMinus);
+            Map(GamepadButtonInputId.LeftShoulder, left.ButtonL);
+            Map(GamepadButtonInputId.RightShoulder, right.ButtonR);
+            Map(GamepadButtonInputId.LeftTrigger, left.ButtonZl);
+            Map(GamepadButtonInputId.RightTrigger, right.ButtonZr);
+            Map(GamepadButtonInputId.DpadUp, left.DpadUp);
+            Map(GamepadButtonInputId.DpadDown, left.DpadDown);
+            Map(GamepadButtonInputId.DpadLeft, left.DpadLeft);
+            Map(GamepadButtonInputId.DpadRight, left.DpadRight);
+            Map(GamepadButtonInputId.LeftStick, _config.LeftJoyconStick.StickButton);
+            Map(GamepadButtonInputId.RightStick, _config.RightJoyconStick.StickButton);
+
+            var leftStick = _config.LeftJoyconStick;
+            var rightStick = _config.RightJoyconStick;
+            (float x, float y) = raw.GetStick((StickInputId)leftStick.Joystick);
+            if (leftStick.InvertStickX) x = -x;
+            if (leftStick.InvertStickY) y = -y;
+            if (leftStick.Rotate90CW) (x, y) = (y, -x);
+            result.SetStick(StickInputId.Left, x, y);
+
+            (x, y) = raw.GetStick((StickInputId)rightStick.Joystick);
+            if (rightStick.InvertStickX) x = -x;
+            if (rightStick.InvertStickY) y = -y;
+            if (rightStick.Rotate90CW) (x, y) = (y, -x);
+            result.SetStick(StickInputId.Right, x, y);
+
+            return result;
+        }
+    }
+
+    private GamepadStateSnapshot ToGamepadState(CouchSlotRead snapshot)
+    {
+        GamepadStateSnapshot result = default;
+        for (int i = 1; i <= 16; i++)
+        {
+            result.SetPressed((GamepadButtonInputId)i, (snapshot.Buttons & (1U << i)) != 0);
+        }
+
+        result.SetPressed(GamepadButtonInputId.LeftTrigger, snapshot.LT > _threshold);
+        result.SetPressed(GamepadButtonInputId.RightTrigger, snapshot.RT > _threshold);
+        result.SetStick(StickInputId.Left, snapshot.LX, snapshot.LY);
+        result.SetStick(StickInputId.Right, snapshot.RX, snapshot.RY);
+        return result;
+    }
+}
diff --git a/src/Ryujinx.Input.SDL2/DiagnosticPreloadClose.cs b/src/Ryujinx.Input.SDL2/DiagnosticPreloadClose.cs
new file mode 100644
index 0000000000000000000000000000000000000000..985968f515f16fdb5a7b8edc5de42708b330dd02
--- /dev/null
+++ b/src/Ryujinx.Input.SDL2/DiagnosticPreloadClose.cs
@@ -0,0 +1,234 @@
+using System;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Text.Json;
+using System.Threading;
+
+namespace Ryujinx.Input.SDL2;
+
+/// <summary>Opt-in, one-window self-close. No external process/UI control.</summary>
+public sealed class DiagnosticPreloadClose : IDisposable
+{
+    private const long CloseTargetNanoseconds = 60_000_000_000;
+    private const long InvalidAfterNanoseconds = 120_000_000_000;
+    private const long ReplayCloseTargetNanoseconds = 330_000_000_000;
+    private const long ReplayInvalidAfterNanoseconds = 360_000_000_000;
+    private const long Replay600CloseTargetNanoseconds = 600_000_000_000;
+    private const long Replay600InvalidAfterNanoseconds = 630_000_000_000;
+    private static int _started;
+    private volatile bool _cancelled;
+    private int _closeIssued;
+    private readonly string _path;
+    private readonly int _pid;
+    private readonly long _target;
+    private readonly long _invalidAfter;
+    private readonly string _profile;
+    private readonly long _preloadWait;
+    private readonly Action _neutralize;
+    private readonly Action _close;
+    private readonly Thread _thread;
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct MachTimebase { internal uint Numer; internal uint Denom; }
+    [DllImport("/usr/lib/libSystem.B.dylib", EntryPoint = "mach_absolute_time")]
+    private static extern ulong MachAbsoluteTime();
+    [DllImport("/usr/lib/libSystem.B.dylib", EntryPoint = "mach_timebase_info")]
+    private static extern int MachTimebaseInfo(out MachTimebase info);
+
+    internal static long MonotonicNanoseconds()
+    {
+        if (MachTimebaseInfo(out MachTimebase info) != 0 || info.Numer == 0 || info.Denom == 0)
+            throw new InvalidOperationException("monotonic-clock-unavailable");
+        return checked((long)((UInt128)MachAbsoluteTime() * info.Numer / info.Denom));
+    }
+
+    public static DiagnosticPreloadClose TryStartForOwnedWindow(Action neutralize, Action requestNormalClose)
+    {
+        // Default-off must avoid filesystem access, threads, and bridge initialization.
+        if (Environment.GetEnvironmentVariable("SMASH_COUCH_DIAGNOSTIC_CLOSE") != "1") return null;
+        if (Interlocked.CompareExchange(ref _started, 1, 0) != 0) return null;
+        try
+        {
+            if (!OperatingSystem.IsMacOS()) throw new InvalidOperationException("macos-only");
+            string profile = Environment.GetEnvironmentVariable("SMASH_COUCH_DIAGNOSTIC_CLOSE_PROFILE");
+            CloseProfile selected = SelectProfile(profile);
+            string stage = Environment.GetEnvironmentVariable("SMASH_COUCH_DIAGNOSTIC_CLOSE_STAGE");
+            string path = ValidateStage(stage, AppContext.BaseDirectory);
+            return StartOwnedWatchForProfile(path, Environment.ProcessId, selected.Target,
+                240_000_000_000, neutralize, requestNormalClose, selected.Name);
+        }
+        catch (Exception e)
+        {
+            Report("setup-refused", new { error = e.GetType().Name });
+            return null;
+        }
+    }
+
+    internal static string ValidateStage(string stage, string appBase)
+    {
+        if (string.IsNullOrEmpty(stage) || !Path.IsPathFullyQualified(stage))
+            throw new InvalidOperationException("stage-missing");
+        stage = Path.GetFullPath(stage).TrimEnd(Path.DirectorySeparatorChar);
+        string lab = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
+            "Library", "Application Support", "Smash Couch", "Lab") + Path.DirectorySeparatorChar;
+        if (!stage.StartsWith(lab, StringComparison.Ordinal) || stage.Contains("..", StringComparison.Ordinal) ||
+            !Path.GetFullPath(appBase).StartsWith(stage + Path.DirectorySeparatorChar, StringComparison.Ordinal))
+            throw new InvalidOperationException("foreign-stage");
+        RejectLinks(new DirectoryInfo(stage));
+        if (!Directory.Exists(appBase)) throw new InvalidOperationException("application-base-missing");
+        RejectLinks(new DirectoryInfo(appBase));
+        if (!File.Exists(Path.Combine(stage, "owner-manifest.json")))
+            throw new InvalidOperationException("owner-manifest-missing");
+        RejectLinks(new FileInfo(Path.Combine(stage, "owner-manifest.json")));
+        return Path.Combine(stage, "preload-status.json");
+    }
+
+    private static void RejectLinks(FileSystemInfo info)
+    {
+        for (FileSystemInfo current = info; current != null; current = current is FileInfo f ? f.Directory : ((DirectoryInfo)current).Parent)
+        {
+            if ((current.Attributes & FileAttributes.ReparsePoint) != 0)
+                throw new InvalidOperationException("symlink-refused");
+        }
+    }
+
+    internal readonly record struct CloseProfile(string Name, long Target, long InvalidAfter);
+
+    // Only fixed profiles are selectable; no arbitrary duration from environment.
+    internal static CloseProfile SelectProfile(string profile) => profile switch
+    {
+        null or "" or "smoke60" => new("smoke60", CloseTargetNanoseconds, InvalidAfterNanoseconds),
+        "replay330" => new("replay330", ReplayCloseTargetNanoseconds, ReplayInvalidAfterNanoseconds),
+        "replay600" => new("replay600", Replay600CloseTargetNanoseconds, Replay600InvalidAfterNanoseconds),
+        _ => throw new ArgumentException("unknown-diagnostic-close-profile"),
+    };
+
+    // Existing CPU fixtures retain the smoke profile and shortened target.
+    // Production uses the exact selected fixed target. This internal seam cannot
+    // obtain a duration from the environment or exceed its selected profile.
+    internal static DiagnosticPreloadClose StartOwnedWatch(string path, int pid, long target,
+        long preloadWait, Action neutralize, Action requestNormalClose)
+    {
+        return StartOwnedWatchForProfile(path, pid, target, preloadWait, neutralize, requestNormalClose, "smoke60");
+    }
+
+    internal static DiagnosticPreloadClose StartOwnedWatchForProfile(string path, int pid, long target,
+        long preloadWait, Action neutralize, Action requestNormalClose, string profile)
+    {
+        CloseProfile selected = SelectProfile(profile);
+        if (pid <= 0 || target <= 0 || target > selected.Target || preloadWait <= 0 ||
+            neutralize == null || requestNormalClose == null) throw new ArgumentException("invalid-watch-contract");
+        return new DiagnosticPreloadClose(path, pid, target, preloadWait, neutralize, requestNormalClose, selected);
+    }
+
+    private DiagnosticPreloadClose(string path, int pid, long target, long preloadWait, Action neutralize, Action close,
+        CloseProfile profile)
+    {
+        _path = path; _pid = pid; _target = target; _preloadWait = preloadWait;
+        _invalidAfter = profile.InvalidAfter; _profile = profile.Name;
+        _neutralize = neutralize; _close = close;
+        _thread = new Thread(Watch) { IsBackground = true, Name = "Owned diagnostic normal-close deadline" };
+        _thread.Start();
+    }
+
+    private readonly record struct MarkerIdentity(long Origin, string Hash, long Length, long CreationTicks, long WriteTicks);
+
+    private MarkerIdentity? ReadMarker()
+    {
+        if (!File.Exists(_path)) return null;
+        FileInfo before = new(_path);
+        RejectLinks(before);
+        if (before.Length <= 0 || before.Length > 4096) throw new InvalidOperationException("marker-size");
+        long creation = before.CreationTimeUtc.Ticks, write = before.LastWriteTimeUtc.Ticks, size = before.Length;
+        byte[] bytes = File.ReadAllBytes(_path);
+        FileInfo after = new(_path);
+        RejectLinks(after);
+        if (after.Length != size || after.CreationTimeUtc.Ticks != creation || after.LastWriteTimeUtc.Ticks != write)
+            throw new InvalidOperationException("marker-changed-during-read");
+        using JsonDocument document = JsonDocument.Parse(bytes);
+        JsonElement r = document.RootElement;
+        if (r.GetProperty("child_pid").GetInt32() != _pid) throw new InvalidOperationException("foreign-pid");
+        string state = r.GetProperty("state").GetString();
+        if (state == "ready") return null;
+        if (state != "complete") throw new InvalidOperationException("preload-not-complete");
+        long origin = r.GetProperty("monotonic_ns").GetInt64();
+        long start = r.GetProperty("start_monotonic_ns").GetInt64();
+        long now = MonotonicNanoseconds();
+        if (origin <= 0 || start <= 0 || start > origin || origin > now || now - origin >= _invalidAfter)
+            throw new InvalidOperationException("invalid-preload-origin");
+        return new MarkerIdentity(origin, Convert.ToHexString(SHA256.HashData(bytes)), size, creation, write);
+    }
+
+    private void Watch()
+    {
+        try
+        {
+            long began = MonotonicNanoseconds();
+            MarkerIdentity? original = null;
+            while (!_cancelled)
+            {
+                long now = MonotonicNanoseconds();
+                MarkerIdentity? current = ReadMarker();
+                if (original == null)
+                {
+                    if (current != null)
+                    {
+                        original = current;
+                        Report("armed", new { child_pid = _pid, origin_ns = original.Value.Origin,
+                            close_target_ns = _target, observed_ns = now, profile = _profile, invalid_after_ns = _invalidAfter });
+                    }
+                    else if (now - began >= _preloadWait)
+                    {
+                        IssueClose("preload-timeout", null);
+                        return;
+                    }
+                }
+                else if (current == null || current.Value != original.Value)
+                {
+                    IssueClose("original-preload-marker-changed", original.Value.Origin);
+                    return;
+                }
+                if (original != null && now - original.Value.Origin >= _target)
+                {
+                    IssueClose("original-preload-deadline", original.Value.Origin);
+                    return;
+                }
+                Thread.Sleep(20);
+            }
+            Report("cancelled", new { child_pid = _pid });
+        }
+        catch (Exception e)
+        {
+            Report("marker-or-watch-refused", new { child_pid = _pid, error = e.GetType().Name, reason = e.Message });
+            IssueClose("watch-refusal", null);
+        }
+    }
+
+    private void IssueClose(string reason, long? origin)
+    {
+        if (_cancelled || Interlocked.Exchange(ref _closeIssued, 1) != 0) return;
+        // Gate/neutral is synchronous and precedes the exact-window UI dispatch.
+        try
+        {
+            _neutralize();
+            Report("input-stopped-neutral", new { child_pid = _pid, profile = _profile, reason, origin_ns = origin,
+                stopped_ns = MonotonicNanoseconds() });
+        }
+        catch (Exception e) { Report("neutral-failed", new { child_pid = _pid, error = e.GetType().Name }); }
+        try
+        {
+            _close();
+            Report("normal-close-posted", new { child_pid = _pid, profile = _profile, requested_ns = MonotonicNanoseconds() });
+        }
+        catch (Exception e) { Report("close-request-failed", new { child_pid = _pid, error = e.GetType().Name }); }
+    }
+
+    private static void Report(string status, object fields)
+    {
+        try { Console.Error.WriteLine("SMASH_DIAGNOSTIC_CLOSE " + JsonSerializer.Serialize(new { status, fields })); }
+        catch { }
+    }
+
+    public void Dispose() { _cancelled = true; }
+}
diff --git a/src/Ryujinx.Input.SDL2/InputFreshnessTraceFinalization.cs b/src/Ryujinx.Input.SDL2/InputFreshnessTraceFinalization.cs
new file mode 100644
index 0000000000000000000000000000000000000000..d43a4f379e77fc940e59fe99b8e3e848a27ec802
--- /dev/null
+++ b/src/Ryujinx.Input.SDL2/InputFreshnessTraceFinalization.cs
@@ -0,0 +1,302 @@
+using System;
+using System.IO;
+using System.Threading;
+using System.Text.Json;
+
+namespace Ryujinx.Input.SDL2;
+
+internal enum InputFreshnessTraceFinalizationStatus
+{
+    Disabled,
+    Requested,
+    InitializationFailed,
+    MissingPath,
+    DrainTimeout,
+    ExportFailed,
+    Completed,
+}
+
+internal readonly struct InputFreshnessTraceExportResult
+{
+    internal InputFreshnessTraceFinalizationStatus Status { get; }
+    internal bool SnapshotCaptured { get; }
+    internal int RecordCount { get; }
+    internal string Error { get; }
+
+    internal InputFreshnessTraceExportResult(
+        InputFreshnessTraceFinalizationStatus status,
+        bool snapshotCaptured,
+        int recordCount,
+        string error)
+    {
+        Status = status;
+        SnapshotCaptured = snapshotCaptured;
+        RecordCount = recordCount;
+        Error = error;
+    }
+}
+
+internal interface IInputFreshnessTraceArtifactPublisher
+{
+    bool TryPublish(string finalPath, byte[] contents, CancellationToken cancellationToken, out string error);
+}
+
+internal sealed class FileInputFreshnessTraceArtifactPublisher : IInputFreshnessTraceArtifactPublisher
+{
+    public bool TryPublish(string finalPath, byte[] contents, CancellationToken cancellationToken, out string error)
+    {
+        string temporaryPath = null;
+        bool published = false;
+        bool cleanupFailed = false;
+        error = null;
+
+        try
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            temporaryPath = finalPath + "." + Guid.NewGuid().ToString("N") + ".partial";
+
+            using (FileStream stream = new(temporaryPath, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+            {
+                stream.Write(contents, 0, contents.Length);
+                stream.Flush(true);
+            }
+
+            cancellationToken.ThrowIfCancellationRequested();
+            File.Move(temporaryPath, finalPath, overwrite: false);
+            published = true;
+            return true;
+        }
+        catch (Exception exception)
+        {
+            error = exception.GetType().Name;
+            return false;
+        }
+        finally
+        {
+            if (!published && temporaryPath != null)
+            {
+                try
+                {
+                    File.Delete(temporaryPath);
+                }
+                catch
+                {
+                    cleanupFailed = true;
+                }
+            }
+
+            if (cleanupFailed)
+            {
+                error = error == null ? "TemporaryCleanupFailed" : $"{error};TemporaryCleanupFailed";
+            }
+        }
+    }
+}
+
+/// <summary>
+/// Owns the single background finalization worker. The process-exit caller only starts the worker,
+/// waits for the bounded interval, and latches a failure if it does not finish in time.
+/// </summary>
+internal sealed class InputFreshnessTraceFinalizationWorker
+{
+    internal const int DefaultExitWaitMilliseconds = 1_000;
+
+    private readonly bool _enabled;
+    private readonly string _finalPath;
+    private readonly Func<InputFreshnessTraceRecorder> _recorderProvider;
+    private readonly IInputFreshnessTraceArtifactPublisher _publisher;
+    private readonly Action<string> _reportStatus;
+    private readonly int _drainTimeoutMilliseconds;
+    private readonly int _exitWaitMilliseconds;
+    private readonly ManualResetEvent _completed = new(false);
+    private readonly CancellationTokenSource _cancellation = new();
+    private int _status;
+    private int _started;
+    private int _processExitFailureObserved;
+
+    internal InputFreshnessTraceExportResult LastResult { get; private set; }
+    internal bool ProcessExitFailureObserved => Volatile.Read(ref _processExitFailureObserved) != 0;
+
+    internal InputFreshnessTraceFinalizationWorker(
+        bool enabled,
+        string finalPath,
+        Func<InputFreshnessTraceRecorder> recorderProvider,
+        IInputFreshnessTraceArtifactPublisher publisher = null,
+        Action<string> reportStatus = null,
+        int drainTimeoutMilliseconds = InputFreshnessTraceRecorder.DefaultDrainTimeoutMilliseconds,
+        int exitWaitMilliseconds = DefaultExitWaitMilliseconds)
+    {
+        _enabled = enabled;
+        _finalPath = finalPath;
+        _recorderProvider = recorderProvider;
+        _publisher = publisher ?? new FileInputFreshnessTraceArtifactPublisher();
+        _reportStatus = reportStatus ?? ReportToStandardError;
+        _drainTimeoutMilliseconds = Math.Max(0, drainTimeoutMilliseconds);
+        _exitWaitMilliseconds = Math.Max(0, exitWaitMilliseconds);
+        _status = (int)(enabled ? InputFreshnessTraceFinalizationStatus.Requested : InputFreshnessTraceFinalizationStatus.Disabled);
+    }
+
+    internal InputFreshnessTraceFinalizationStatus Status => (InputFreshnessTraceFinalizationStatus)Volatile.Read(ref _status);
+
+    internal void MarkInitializationFailed()
+    {
+        Interlocked.CompareExchange(
+            ref _status,
+            (int)InputFreshnessTraceFinalizationStatus.InitializationFailed,
+            (int)InputFreshnessTraceFinalizationStatus.Requested);
+    }
+
+    internal bool RunProcessExitBounded()
+    {
+        if (!_enabled)
+        {
+            return true;
+        }
+
+        if (Interlocked.Exchange(ref _started, 1) == 0)
+        {
+            try
+            {
+                Thread worker = new(FinalizeOnBackgroundThread)
+                {
+                    IsBackground = true,
+                    Name = "Input freshness trace finalizer",
+                };
+                worker.Start();
+            }
+            catch
+            {
+                Interlocked.CompareExchange(
+                    ref _status,
+                    (int)InputFreshnessTraceFinalizationStatus.ExportFailed,
+                    (int)InputFreshnessTraceFinalizationStatus.Requested);
+                return false;
+            }
+        }
+
+        bool completed;
+        try
+        {
+            completed = _completed.WaitOne(_exitWaitMilliseconds);
+        }
+        catch
+        {
+            completed = false;
+        }
+
+        if (completed)
+        {
+            return Status == InputFreshnessTraceFinalizationStatus.Completed;
+        }
+
+        LatchProcessExitTimeout();
+        _cancellation.Cancel();
+        return false;
+    }
+
+    internal void MarkProcessExitFailureObserved()
+    {
+        Interlocked.Exchange(ref _processExitFailureObserved, 1);
+        LatchProcessExitTimeout();
+    }
+
+    private void FinalizeOnBackgroundThread()
+    {
+        string detail = null;
+        InputFreshnessTraceRecorder observedRecorder = null;
+
+        try
+        {
+            InputFreshnessTraceFinalizationStatus currentStatus = Status;
+            if (string.IsNullOrWhiteSpace(_finalPath))
+            {
+                SetFinalStatus(InputFreshnessTraceFinalizationStatus.MissingPath);
+                detail = "trace-path-missing";
+            }
+            else if (currentStatus == InputFreshnessTraceFinalizationStatus.InitializationFailed)
+            {
+                detail = "recorder-initialization-failed";
+            }
+            else
+            {
+                InputFreshnessTraceRecorder recorder = _recorderProvider?.Invoke();
+                observedRecorder = recorder;
+                if (recorder == null)
+                {
+                    SetFinalStatus(InputFreshnessTraceFinalizationStatus.ExportFailed);
+                    detail = "recorder-not-initialized";
+                }
+                else
+                {
+                    InputFreshnessTraceExportResult result = recorder.TryFinalizeToNewFile(
+                        _finalPath,
+                        _drainTimeoutMilliseconds,
+                        _publisher,
+                        _cancellation.Token);
+                    LastResult = result;
+                    SetFinalStatus(result.Status);
+                    detail = result.Error;
+                }
+            }
+        }
+        catch (Exception exception)
+        {
+            SetFinalStatus(InputFreshnessTraceFinalizationStatus.ExportFailed);
+            detail = exception.GetType().Name;
+        }
+        finally
+        {
+            try
+            {
+                _reportStatus?.Invoke($"SMASH_INPUT_TRACE status={Status} detail={detail ?? "none"}");
+                _reportStatus?.Invoke("SMASH_INPUT_TRACE_COUNTERS " + JsonSerializer.Serialize(new
+                {
+                    status = Status.ToString(),
+                    capacity = observedRecorder?.Capacity,
+                    recorded = observedRecorder?.RecordCount,
+                    reserved = observedRecorder?.ReservedCount,
+                    overflow_count = observedRecorder?.OverflowCount,
+                    error_count = observedRecorder?.ErrorCount,
+                    complete = observedRecorder?.IsComplete,
+                    snapshot_captured = LastResult.SnapshotCaptured,
+                    snapshot_records = LastResult.RecordCount,
+                    result_error = LastResult.Error,
+                }));
+            }
+            catch
+            {
+                // Reporting is diagnostic only and remains outside input handling.
+            }
+
+            _completed.Set();
+        }
+    }
+
+    private void LatchProcessExitTimeout()
+    {
+        while (true)
+        {
+            int current = Volatile.Read(ref _status);
+            if (current != (int)InputFreshnessTraceFinalizationStatus.Requested &&
+                current != (int)InputFreshnessTraceFinalizationStatus.Completed)
+            {
+                return;
+            }
+
+            if (Interlocked.CompareExchange(ref _status, (int)InputFreshnessTraceFinalizationStatus.ExportFailed, current) == current)
+            {
+                return;
+            }
+        }
+    }
+
+    private void SetFinalStatus(InputFreshnessTraceFinalizationStatus status)
+    {
+        Interlocked.CompareExchange(ref _status, (int)status, (int)InputFreshnessTraceFinalizationStatus.Requested);
+    }
+
+    private static void ReportToStandardError(string message)
+    {
+        Console.Error.WriteLine(message);
+    }
+}
diff --git a/src/Ryujinx.Input.SDL2/InputFreshnessTraceRecorder.cs b/src/Ryujinx.Input.SDL2/InputFreshnessTraceRecorder.cs
new file mode 100644
index 0000000000000000000000000000000000000000..258a8bd42b51074d7a5f9ad8c6760144a3ca0214
--- /dev/null
+++ b/src/Ryujinx.Input.SDL2/InputFreshnessTraceRecorder.cs
@@ -0,0 +1,386 @@
+using Ryujinx.HLE.HOS.Services.Hid;
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Threading;
+
+namespace Ryujinx.Input.SDL2;
+
+/// <summary>
+/// Preallocated, bounded sink for completed input-to-primary-ring observations.
+/// Snapshot and export allocate only when called outside the input path.
+/// </summary>
+internal sealed class InputFreshnessTraceRecorder : INpadInputFreshnessWriteObserver
+{
+    internal const int DefaultCapacity = 65_536;
+    internal const int DefaultDrainTimeoutMilliseconds = 100;
+    private const string ObservationWindowVariable = "SMASH_COUCH_INPUT_TRACE_OBSERVATION_WINDOW";
+    private const string ObservationWindowMode = "join-p1-45s";
+    private const ulong ObservationWindowNanoseconds = 45_000_000_000;
+    private readonly bool _observationWindowEnabled;
+    private readonly object _observationWindowGate;
+    private bool _observationArmed;
+    private ulong _observationStart;
+    private ulong _observationCutoff;
+    private ulong _observationLastObserved;
+    private ulong? _observationLastIncluded;
+    private ulong? _observationEnd;
+    private ulong _observationNumerator;
+    private ulong _observationDenominator;
+    private string _observationEndReason = "unarmed";
+    private long _prearmCallbackCount;
+    private long _postWindowCallbackCount;
+
+    private readonly NpadInputFreshnessTraceEvent[] _records;
+    private readonly Func<ulong> _nowTicks;
+    private long _reserved;
+    private int _recorded;
+    private int _overflowCount;
+    private int _errorCount;
+    private int _failed;
+    private int _activeWriters;
+    private int _closed;
+
+    internal InputFreshnessTraceRecorder(Func<ulong> nowTicks, int capacity = DefaultCapacity)
+    {
+        if (capacity <= 0) throw new ArgumentOutOfRangeException(nameof(capacity));
+        _nowTicks = nowTicks ?? throw new ArgumentNullException(nameof(nowTicks));
+        _records = new NpadInputFreshnessTraceEvent[capacity];
+        _observationWindowEnabled = string.Equals(
+            Environment.GetEnvironmentVariable(ObservationWindowVariable), ObservationWindowMode, StringComparison.Ordinal);
+        if (_observationWindowEnabled) _observationWindowGate = new object();
+    }
+
+    internal bool IsComplete => Volatile.Read(ref _failed) == 0;
+    internal int Capacity => _records.Length;
+    internal int RecordCount => Volatile.Read(ref _recorded);
+    internal long ReservedCount => Interlocked.Read(ref _reserved);
+    internal int OverflowCount => Volatile.Read(ref _overflowCount);
+    internal int ErrorCount => Volatile.Read(ref _errorCount);
+
+    public void RecordPrimaryRingWrite(
+        in NpadInputFreshnessProvenance provenance,
+        PlayerIndex playerIndex,
+        NpadInputFreshnessRingKind ringKind,
+        ulong samplingNumber,
+        ControllerKeys buttons,
+        JoystickPosition leftStick,
+        JoystickPosition rightStick)
+    {
+        if (Volatile.Read(ref _failed) != 0 || Volatile.Read(ref _closed) != 0) return;
+
+        Interlocked.Increment(ref _activeWriters);
+        if (Volatile.Read(ref _closed) != 0)
+        {
+            Interlocked.Decrement(ref _activeWriters);
+            return;
+        }
+
+        try
+        {
+            if (Volatile.Read(ref _failed) != 0) return;
+
+            // This is intentionally the first clock operation after the HLE callback.
+            ulong ringWriteMachTicks = _nowTicks();
+            if (_observationWindowEnabled)
+            {
+                lock (_observationWindowGate)
+                {
+                    if (Volatile.Read(ref _failed) != 0) return;
+                    if (!IncludeObservation(provenance, playerIndex, ringWriteMachTicks)) return;
+                    if (StoreRecord(provenance, ringWriteMachTicks, playerIndex, ringKind,
+                        samplingNumber, buttons, leftStick, rightStick))
+                    {
+                        _observationLastIncluded = ringWriteMachTicks;
+                    }
+                }
+            }
+            else
+            {
+                StoreRecord(provenance, ringWriteMachTicks, playerIndex, ringKind,
+                    samplingNumber, buttons, leftStick, rightStick);
+            }
+        }
+        catch
+        {
+            MarkIncomplete();
+        }
+        finally
+        {
+            Interlocked.Decrement(ref _activeWriters);
+        }
+    }
+
+    private bool StoreRecord(in NpadInputFreshnessProvenance provenance, ulong ringWriteMachTicks,
+        PlayerIndex playerIndex, NpadInputFreshnessRingKind ringKind, ulong samplingNumber,
+        ControllerKeys buttons, JoystickPosition leftStick, JoystickPosition rightStick)
+    {
+        long index = Interlocked.Increment(ref _reserved) - 1;
+        if ((ulong)index >= (ulong)_records.Length)
+        {
+            Interlocked.Increment(ref _overflowCount);
+            Interlocked.Exchange(ref _failed, 1);
+            return false;
+        }
+        if (Volatile.Read(ref _failed) != 0) return false;
+        _records[index] = new NpadInputFreshnessTraceEvent(provenance, ringWriteMachTicks,
+            playerIndex, ringKind, samplingNumber, buttons, leftStick, rightStick);
+        Interlocked.Increment(ref _recorded);
+        return true;
+    }
+
+    private bool IncludeObservation(in NpadInputFreshnessProvenance provenance, PlayerIndex playerIndex, ulong now)
+    {
+        if (!_observationArmed)
+        {
+            if (provenance.ReadStatus != NpadInputFreshnessReadStatus.FreshEnabled ||
+                provenance.LogicalSlot != 0 || playerIndex != PlayerIndex.Player1)
+            {
+                _prearmCallbackCount++;
+                return false;
+            }
+            if (provenance.TimebaseNumerator == 0 || provenance.TimebaseDenominator == 0)
+                throw new InvalidOperationException("Observation timebase is missing");
+            UInt128 interval = (UInt128)ObservationWindowNanoseconds * provenance.TimebaseDenominator / provenance.TimebaseNumerator;
+            if (interval == 0 || interval > ulong.MaxValue || interval > ulong.MaxValue - now)
+                throw new InvalidOperationException("Observation cutoff is not representable");
+            _observationStart = now;
+            _observationCutoff = now + (ulong)interval;
+            _observationNumerator = provenance.TimebaseNumerator;
+            _observationDenominator = provenance.TimebaseDenominator;
+            _observationLastObserved = now;
+            _observationArmed = true;
+        }
+        if (_observationEndReason == "window_elapsed" || now >= _observationCutoff)
+        {
+            _observationEnd = _observationCutoff;
+            _observationEndReason = "window_elapsed";
+            _postWindowCallbackCount++;
+            return false;
+        }
+        if (now < _observationLastObserved || provenance.TimebaseNumerator != _observationNumerator ||
+            provenance.TimebaseDenominator != _observationDenominator || provenance.ReadStatus == NpadInputFreshnessReadStatus.NotTraced)
+            throw new InvalidOperationException("Observation callback clock/provenance is inconsistent");
+        _observationLastObserved = now;
+        return true;
+    }
+
+    private void FinishObservationWindow()
+    {
+        if (!_observationArmed || _observationEndReason == "window_elapsed") return;
+        ulong now = _nowTicks();
+        if (now < _observationLastObserved) throw new InvalidOperationException("Observation freeze clock regressed");
+        _observationEnd = Math.Min(now, _observationCutoff);
+        _observationEndReason = now >= _observationCutoff ? "window_elapsed" : "export_before_window_end";
+    }
+
+    public void MarkIncomplete()
+    {
+        Interlocked.Increment(ref _errorCount);
+        Interlocked.Exchange(ref _failed, 1);
+    }
+
+    private bool TryFreezeAndCopyRecords(int timeoutMilliseconds, out NpadInputFreshnessTraceEvent[] records)
+    {
+        Interlocked.Exchange(ref _closed, 1);
+        records = Array.Empty<NpadInputFreshnessTraceEvent>();
+        long started = Stopwatch.GetTimestamp();
+        long timeoutTicks = (long)((UInt128)(uint)Math.Max(0, timeoutMilliseconds) * (ulong)Stopwatch.Frequency / 1_000);
+
+        while (Volatile.Read(ref _activeWriters) != 0)
+        {
+            long elapsedTicks = Stopwatch.GetTimestamp() - started;
+            if (elapsedTicks >= timeoutTicks)
+            {
+                MarkIncomplete();
+                return false;
+            }
+
+            Thread.Sleep(1);
+        }
+
+        if (_observationWindowEnabled)
+        {
+            try { FinishObservationWindow(); }
+            catch { MarkIncomplete(); }
+        }
+        records = CopyFrozenRecords();
+        return true;
+    }
+
+    private NpadInputFreshnessTraceEvent[] CopyFrozenRecords()
+    {
+        if (Volatile.Read(ref _closed) == 0 || Volatile.Read(ref _activeWriters) != 0)
+        {
+            throw new InvalidOperationException("Input freshness trace must be frozen before copying");
+        }
+
+        int count = Math.Min(Volatile.Read(ref _recorded), _records.Length);
+        NpadInputFreshnessTraceEvent[] result = new NpadInputFreshnessTraceEvent[count];
+        int written = 0;
+        long limit = Math.Min(Volatile.Read(ref _reserved), _records.Length);
+
+        for (int i = 0; i < limit && written < count; i++)
+        {
+            NpadInputFreshnessTraceEvent record = _records[i];
+            if (record.Provenance.ReadStatus != NpadInputFreshnessReadStatus.NotTraced)
+            {
+                result[written++] = record;
+            }
+        }
+
+        if (written == result.Length) return result;
+        Array.Resize(ref result, written);
+        return result;
+    }
+
+    internal bool TryExportToNewFile(string path)
+    {
+        InputFreshnessTraceExportResult result = ExportToNewFile(
+            path,
+            DefaultDrainTimeoutMilliseconds,
+            new FileInputFreshnessTraceArtifactPublisher(),
+            CancellationToken.None,
+            requireCompleteCoverage: true);
+
+        return result.Status == InputFreshnessTraceFinalizationStatus.Completed;
+    }
+
+    internal InputFreshnessTraceExportResult TryFinalizeToNewFile(
+        string path,
+        int drainTimeoutMilliseconds,
+        IInputFreshnessTraceArtifactPublisher publisher,
+        CancellationToken cancellationToken)
+    {
+        return ExportToNewFile(path, drainTimeoutMilliseconds, publisher, cancellationToken, requireCompleteCoverage: true);
+    }
+
+    private InputFreshnessTraceExportResult ExportToNewFile(
+        string path,
+        int drainTimeoutMilliseconds,
+        IInputFreshnessTraceArtifactPublisher publisher,
+        CancellationToken cancellationToken,
+        bool requireCompleteCoverage)
+    {
+        NpadInputFreshnessTraceEvent[] records;
+        if (!TryFreezeAndCopyRecords(drainTimeoutMilliseconds, out records))
+        {
+            return new InputFreshnessTraceExportResult(
+                InputFreshnessTraceFinalizationStatus.DrainTimeout,
+                snapshotCaptured: false,
+                recordCount: 0,
+                error: "active-writer-drain-timeout");
+        }
+
+        if (requireCompleteCoverage && !IsComplete)
+        {
+            return new InputFreshnessTraceExportResult(
+                InputFreshnessTraceFinalizationStatus.ExportFailed,
+                snapshotCaptured: true,
+                recordCount: records.Length,
+                error: "trace-coverage-incomplete");
+        }
+
+        try
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            byte[] serialized;
+            if (_observationWindowEnabled)
+            {
+                serialized = JsonSerializer.SerializeToUtf8Bytes(new
+            {
+                schema = "smash-couch-input-freshness-trace-v1",
+                trace_complete = IsComplete,
+                coverage_end = "export_freeze",
+                writers_stopped_before_snapshot = true,
+                capacity = Capacity,
+                record_count = records.Length,
+                overflow_count = OverflowCount,
+                error_count = ErrorCount,
+                records,
+                observation_window = new
+                {
+                    mode = ObservationWindowMode,
+                    scope = "armed_callbacks_only_not_whole_launch",
+                    arm_trigger = "first_fresh_enabled_logical_slot0_player1_callback",
+                    clock_domain = "darwin_mach_continuous_ticks",
+                    max_duration_ns = ObservationWindowNanoseconds,
+                    armed = _observationArmed,
+                    start_mach_ticks = _observationArmed ? (ulong?)_observationStart : null,
+                    end_mach_ticks = _observationEnd,
+                    last_included_mach_ticks = _observationLastIncluded,
+                    timebase_numerator = _observationArmed ? (ulong?)_observationNumerator : null,
+                    timebase_denominator = _observationArmed ? (ulong?)_observationDenominator : null,
+                    end_reason = _observationEndReason,
+                    prearm_callback_count = _prearmCallbackCount,
+                    post_window_callback_count = _postWindowCallbackCount,
+                },
+            }, new JsonSerializerOptions
+            {
+                WriteIndented = true,
+                PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower,
+                IncludeFields = true,
+                Converters = { new JsonStringEnumConverter() },
+            });
+            }
+            else
+            {
+                serialized = JsonSerializer.SerializeToUtf8Bytes(new
+            {
+                schema = "smash-couch-input-freshness-trace-v1",
+                trace_complete = IsComplete,
+                coverage_end = "export_freeze",
+                writers_stopped_before_snapshot = true,
+                capacity = Capacity,
+                record_count = records.Length,
+                overflow_count = OverflowCount,
+                error_count = ErrorCount,
+                records,
+            }, new JsonSerializerOptions
+            {
+                WriteIndented = true,
+                PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower,
+                IncludeFields = true,
+                Converters = { new JsonStringEnumConverter() },
+            });
+            }
+
+            cancellationToken.ThrowIfCancellationRequested();
+            if (!publisher.TryPublish(path, serialized, cancellationToken, out string error))
+            {
+                MarkIncomplete();
+                return new InputFreshnessTraceExportResult(
+                    InputFreshnessTraceFinalizationStatus.ExportFailed,
+                    snapshotCaptured: true,
+                    recordCount: records.Length,
+                    error ?? "artifact-publication-failed");
+            }
+
+            return new InputFreshnessTraceExportResult(
+                InputFreshnessTraceFinalizationStatus.Completed,
+                snapshotCaptured: true,
+                recordCount: records.Length,
+                error: null);
+        }
+        catch (OperationCanceledException)
+        {
+            MarkIncomplete();
+            return new InputFreshnessTraceExportResult(
+                InputFreshnessTraceFinalizationStatus.ExportFailed,
+                snapshotCaptured: true,
+                recordCount: records.Length,
+                error: "finalization-canceled");
+        }
+        catch
+        {
+            MarkIncomplete();
+            return new InputFreshnessTraceExportResult(
+                InputFreshnessTraceFinalizationStatus.ExportFailed,
+                snapshotCaptured: true,
+                recordCount: records.Length,
+                error: "serialization-or-publication-failed");
+        }
+    }
+}
