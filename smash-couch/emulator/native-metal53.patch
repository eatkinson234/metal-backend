diff --git a/src/Ryujinx.Graphics.Metal/NativeFeedbackDiagnostics.cs b/src/Ryujinx.Graphics.Metal/NativeFeedbackDiagnostics.cs
new file mode 100644
index 0000000000000000000000000000000000000000..bfdf569681b6013563955efa95f80566d7954484
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/NativeFeedbackDiagnostics.cs
@@ -0,0 +1,391 @@
+using Ryujinx.Common.Logging;
+using Ryujinx.Graphics.Metal.State;
+using Ryujinx.Graphics.Shader;
+using SharpMetal.Metal;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Threading;
+using System.Runtime.Versioning;
+
+namespace Ryujinx.Graphics.Metal
+{
+    [SupportedOSPlatform("macos")]
+    internal static class NativeFeedbackDiagnostics
+    {
+        private const string EvidenceDirectoryVariable = "SMASH_COUCH_FEEDBACK_EVIDENCE_DIR";
+        private const int MaximumShaderCodeBytes = 8 * 1024 * 1024;
+        private static int _captureClaimed;
+
+        internal static bool Enabled =>
+            !string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable(EvidenceDirectoryVariable));
+
+        internal static void TryCapture(
+            EncoderState state,
+            ResourceBindingSegment[][] sets,
+            string context,
+            RenderFeedbackGuard.FeedbackGuardException guardException)
+        {
+            if (!Enabled || Interlocked.CompareExchange(ref _captureClaimed, 1, 0) != 0)
+            {
+                return;
+            }
+
+            try
+            {
+                Capture(state, sets, context, guardException);
+            }
+            catch (Exception diagnosticException)
+            {
+                // The original feedback guard exception remains authoritative.
+                try
+                {
+                    string message =
+                        $"[CouchNativeFeedback] Evidence capture failed without replacing guard stop: " +
+                        $"{diagnosticException.GetType().Name}: {diagnosticException.Message}";
+                    Logger.Error?.PrintMsg(LogClass.Gpu, message);
+                    Console.Error.WriteLine(message);
+                }
+                catch
+                {
+                    // Logging failure also must not replace the guard stop.
+                }
+            }
+        }
+
+        private static void Capture(
+            EncoderState state,
+            ResourceBindingSegment[][] sets,
+            string context,
+            RenderFeedbackGuard.FeedbackGuardException guardException)
+        {
+            string configured = Environment.GetEnvironmentVariable(EvidenceDirectoryVariable);
+            string directory = Path.GetFullPath(configured);
+            if (!Directory.Exists(directory))
+            {
+                throw new DirectoryNotFoundException("The feedback evidence directory must already exist.");
+            }
+            if ((File.GetAttributes(directory) & FileAttributes.ReparsePoint) != 0)
+            {
+                throw new IOException("The feedback evidence directory must not be a symbolic link.");
+            }
+            if (Directory.EnumerateFileSystemEntries(directory).Any())
+            {
+                throw new IOException("The feedback evidence directory must be fresh and empty.");
+            }
+
+            Dictionary<string, object> programReceipt = WriteActiveProgram(directory, state.RenderProgram);
+            RenderFeedbackGuard.FailureEvidence evidence = guardException.Evidence;
+
+            MTLPixelFormat effectiveFormat = state.Pipeline.DepthStencilFormat;
+            DepthStencilUid requested = state.DepthStencilUid;
+            DepthStencilUid effective = DepthStencilAttachmentState.Effective(requested, effectiveFormat);
+
+            Dictionary<string, object> record = new()
+            {
+                ["schema"] = "smash-couch-native-feedback-diagnostic-v1",
+                ["diagnosticVersion"] = "1.3.3-metal.9",
+                ["capturedUtc"] = DateTimeOffset.UtcNow,
+                ["guardBehavior"] = "same conservative Relation comparison and stop-before-draw throw as .8",
+                ["context"] = context,
+                ["guardMessage"] = guardException.Message,
+                ["failure"] = FailureRecord(evidence),
+                ["depthStencil"] = new Dictionary<string, object>
+                {
+                    ["attachmentFormat"] = effectiveFormat.ToString(),
+                    ["requested"] = DepthStencilRecord(requested, state.FrontRefValue, state.BackRefValue),
+                    ["effective"] = DepthStencilRecord(effective, state.FrontRefValue, state.BackRefValue),
+                },
+                ["rasterState"] = new Dictionary<string, object>
+                {
+                    ["topology"] = state.Topology.ToString(),
+                    ["cullMode"] = state.CullMode.ToString(),
+                    ["cullBoth"] = state.CullBoth,
+                    ["winding"] = state.Winding.ToString(),
+                    ["rasterizerDiscardEnabled"] = state.Pipeline.RasterizerDiscardEnable,
+                },
+                ["renderPassPolicy"] = RenderPassPolicy(state),
+                ["activeBindingSegments"] = SegmentRecords(sets),
+                ["activeProgram"] = programReceipt,
+                ["limits"] = new Dictionary<string, object>
+                {
+                    ["firstFailureOnly"] = true,
+                    ["maximumTotalShaderCodeBytes"] = MaximumShaderCodeBytes,
+                    ["nativeObjectsQueriedOnlyByGuard"] = true,
+                    ["diagnosticsCanProveExecutedShaderBranch"] = false,
+                },
+            };
+
+            byte[] bytes = JsonSerializer.SerializeToUtf8Bytes(record, JsonOptions(indented: true));
+            WriteNew(Path.Combine(directory, "feedback-failure.json"), bytes);
+        }
+
+        private static Dictionary<string, object> WriteActiveProgram(string directory, Program program)
+        {
+            if (program == null)
+            {
+                return new Dictionary<string, object>
+                {
+                    ["present"] = false,
+                    ["reason"] = "No active render program was available.",
+                };
+            }
+
+            List<Dictionary<string, object>> shaders = [];
+            int remaining = MaximumShaderCodeBytes;
+            Program.FeedbackShaderSource[] sources = program.FeedbackShaderSources ?? [];
+            for (int index = 0; index < sources.Length; index++)
+            {
+                Program.FeedbackShaderSource source = sources[index];
+                byte[] fullCode = Encoding.UTF8.GetBytes(source.Code ?? string.Empty);
+                int writeCount = Math.Min(remaining, fullCode.Length);
+                bool truncated = writeCount != fullCode.Length;
+                string fileName = $"active-shader-{index:D2}-{source.Stage}.metal";
+                WriteNew(Path.Combine(directory, fileName), fullCode.AsSpan(0, writeCount));
+                remaining -= writeCount;
+                shaders.Add(new Dictionary<string, object>
+                {
+                    ["stage"] = source.Stage.ToString(),
+                    ["entryPoint"] = source.Stage switch
+                    {
+                        ShaderStage.Vertex => "vertexMain",
+                        ShaderStage.Fragment => "fragmentMain",
+                        ShaderStage.Compute => "kernelMain",
+                        _ => "unsupported",
+                    },
+                    ["file"] = fileName,
+                    ["originalUtf8Bytes"] = fullCode.Length,
+                    ["writtenUtf8Bytes"] = writeCount,
+                    ["truncated"] = truncated,
+                    ["fullCodeSha256"] = Sha256(fullCode),
+                });
+            }
+
+            List<Dictionary<string, object>> usages = [];
+            foreach (Program.FeedbackResourceUsage usage in program.FeedbackResourceUsages ?? [])
+            {
+                usages.Add(new Dictionary<string, object>
+                {
+                    ["set"] = usage.Set,
+                    ["binding"] = usage.Binding,
+                    ["arrayLength"] = usage.ArrayLength,
+                    ["type"] = usage.Type.ToString(),
+                    ["stages"] = usage.Stages.ToString(),
+                    ["write"] = usage.Write,
+                });
+            }
+
+            Dictionary<string, object> manifest = new()
+            {
+                ["schema"] = "smash-couch-native-active-metal-program-v1",
+                ["compileOptions"] = new Dictionary<string, object>
+                {
+                    ["preserveInvariance"] = Program.FeedbackPreserveInvariance,
+                    ["languageVersion"] = program.ShaderLanguageVersion.ToString(),
+                    ["usesPerVertexTransport"] = program.UsesPerVertexTransport,
+                },
+                ["shaderSources"] = shaders,
+                ["resourceUsages"] = usages,
+                ["bindingSegments"] = SegmentRecords(program.BindingSegments),
+            };
+            byte[] manifestBytes = JsonSerializer.SerializeToUtf8Bytes(manifest, JsonOptions(indented: false));
+            string manifestName = "active-program-manifest.json";
+            WriteNew(Path.Combine(directory, manifestName), manifestBytes);
+
+            return new Dictionary<string, object>
+            {
+                ["present"] = true,
+                ["manifestFile"] = manifestName,
+                ["manifestSha256"] = Sha256(manifestBytes),
+                ["shaderCount"] = shaders.Count,
+                ["retainedShaderSourceMode"] = "diagnostic opt-in; immutable Stage/Code references only",
+                ["totalShaderCodeBytesWritten"] = MaximumShaderCodeBytes - remaining,
+                ["anyShaderTruncated"] = shaders.Any(shader => (bool)shader["truncated"]),
+            };
+        }
+
+        private static Dictionary<string, object> FailureRecord(RenderFeedbackGuard.FailureEvidence evidence)
+        {
+            if (evidence == null)
+            {
+                return new Dictionary<string, object>
+                {
+                    ["detailedAliasEvidenceAvailable"] = false,
+                };
+            }
+
+            return new Dictionary<string, object>
+            {
+                ["detailedAliasEvidenceAvailable"] = true,
+                ["relation"] = evidence.Relation.ToString(),
+                ["binding"] = new Dictionary<string, object>
+                {
+                    ["set"] = evidence.Binding.Set,
+                    ["segmentBinding"] = evidence.Binding.Segment.Binding,
+                    ["segmentCount"] = evidence.Binding.Segment.Count,
+                    ["segmentIsArray"] = evidence.Binding.Segment.IsArray,
+                    ["resourceType"] = evidence.Binding.Segment.Type.ToString(),
+                    ["stages"] = evidence.Binding.Segment.Stages.ToString(),
+                    ["actualBinding"] = evidence.Binding.ActualBinding,
+                    ["groupedOffset"] = NullableValue(evidence.Binding.Segment.IsArray ? null : evidence.Binding.GroupedOffset),
+                    ["arrayIndex"] = NullableValue(evidence.Binding.ArrayIndex),
+                    ["arrayLength"] = NullableValue(evidence.Binding.ArrayLength),
+                },
+                ["sampledTexture"] = TextureRecord(evidence.SampledTexture, evidence.ShaderIdentity),
+                ["matchedAttachment"] = new Dictionary<string, object>
+                {
+                    ["role"] = evidence.Attachment.Role,
+                    ["texture"] = TextureRecord(evidence.Attachment.Texture, evidence.Attachment.Identity),
+                    ["loadPolicy"] = evidence.Attachment.LoadPolicy,
+                    ["storePolicy"] = evidence.Attachment.StorePolicy,
+                    ["resolvePolicy"] = evidence.Attachment.ResolvePolicy,
+                },
+            };
+        }
+
+        private static object NullableValue(int? value) => value.HasValue ? value.Value : null;
+
+        private static Dictionary<string, object> TextureRecord(
+            TextureBase texture,
+            RenderFeedbackGuard.Identity identity) => new()
+        {
+            ["valid"] = texture.Valid,
+            ["format"] = texture.Info.Format.ToString(),
+            ["depthStencilMode"] = texture.Info.DepthStencilMode.ToString(),
+            ["mtlFormat"] = texture.MtlFormat.ToString(),
+            ["target"] = texture.Info.Target.ToString(),
+            ["width"] = texture.Info.Width,
+            ["height"] = texture.Info.Height,
+            ["depth"] = texture.Info.Depth,
+            ["declaredLevels"] = texture.Info.Levels,
+            ["declaredLayers"] = texture.Info.GetLayers(),
+            ["firstLevel"] = texture.FirstLevel,
+            ["firstLayer"] = texture.FirstLayer,
+            ["identity"] = IdentityRecord(identity),
+        };
+
+        private static Dictionary<string, object> IdentityRecord(RenderFeedbackGuard.Identity identity) => new()
+        {
+            ["known"] = identity.Known,
+            ["fault"] = identity.Fault,
+            ["view"] = Pointer(identity.View),
+            ["root"] = Pointer(identity.Root),
+            ["buffer"] = Pointer(identity.Buffer),
+            ["gpuResourceId"] = identity.GpuId,
+            ["level"] = identity.Level,
+            ["slice"] = identity.Slice,
+            ["levels"] = identity.Levels,
+            ["layers"] = identity.Layers,
+            ["format"] = identity.Format.ToString(),
+            ["type"] = identity.Type.ToString(),
+        };
+
+        private static string Pointer(IntPtr value) => $"0x{(ulong)value:X}";
+
+        private static Dictionary<string, object> DepthStencilRecord(
+            DepthStencilUid uid,
+            int frontReference,
+            int backReference) => new()
+        {
+            ["depthCompare"] = uid.DepthCompareFunction.ToString(),
+            ["depthWriteEnabled"] = uid.DepthWriteEnabled,
+            ["stencilTestEnabled"] = uid.StencilTestEnabled,
+            ["front"] = StencilRecord(uid.FrontFace, frontReference),
+            ["back"] = StencilRecord(uid.BackFace, backReference),
+        };
+
+        private static Dictionary<string, object> StencilRecord(StencilUid uid, int reference) => new()
+        {
+            ["compare"] = uid.StencilCompareFunction.ToString(),
+            ["readMask"] = uid.ReadMask,
+            ["writeMask"] = uid.WriteMask,
+            ["stencilFailureOperation"] = uid.StencilFailureOperation.ToString(),
+            ["depthFailureOperation"] = uid.DepthFailureOperation.ToString(),
+            ["depthStencilPassOperation"] = uid.DepthStencilPassOperation.ToString(),
+            ["reference"] = reference,
+        };
+
+        private static List<Dictionary<string, object>> RenderPassPolicy(EncoderState state)
+        {
+            List<Dictionary<string, object>> result = [];
+            for (int index = 0; index < state.RenderTargets.Length; index++)
+            {
+                Texture target = state.RenderTargets[index];
+                if (target != null)
+                {
+                    result.Add(new Dictionary<string, object>
+                    {
+                        ["role"] = $"color[{index}]",
+                        ["targetFormat"] = target.MtlFormat.ToString(),
+                        ["loadAction"] = state.ClearLoadAction ? "Clear" : "Load",
+                        ["storeAction"] = "Store",
+                        ["resolveAction"] = "None",
+                    });
+                }
+            }
+            if (state.DepthStencil is Texture depthStencil)
+            {
+                result.Add(new Dictionary<string, object>
+                {
+                    ["role"] = "depth/stencil",
+                    ["targetFormat"] = depthStencil.MtlFormat.ToString(),
+                    ["loadAction"] = "Load for every present aspect",
+                    ["storeAction"] = "Store for every present aspect",
+                    ["resolveAction"] = "None",
+                });
+            }
+            return result;
+        }
+
+        private static List<Dictionary<string, object>> SegmentRecords(ResourceBindingSegment[][] sets)
+        {
+            List<Dictionary<string, object>> result = [];
+            if (sets == null)
+            {
+                return result;
+            }
+            for (int set = 0; set < sets.Length; set++)
+            {
+                if (sets[set] == null)
+                {
+                    continue;
+                }
+                foreach (ResourceBindingSegment segment in sets[set])
+                {
+                    result.Add(new Dictionary<string, object>
+                    {
+                        ["set"] = set,
+                        ["binding"] = segment.Binding,
+                        ["count"] = segment.Count,
+                        ["type"] = segment.Type.ToString(),
+                        ["stages"] = segment.Stages.ToString(),
+                        ["isArray"] = segment.IsArray,
+                    });
+                }
+            }
+            return result;
+        }
+
+        private static JsonSerializerOptions JsonOptions(bool indented)
+        {
+            JsonSerializerOptions options = new() { WriteIndented = indented };
+            options.Converters.Add(new JsonStringEnumConverter());
+            return options;
+        }
+
+        private static string Sha256(ReadOnlySpan<byte> bytes) =>
+            Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
+
+        private static void WriteNew(string path, ReadOnlySpan<byte> bytes)
+        {
+            using FileStream output = new(path, FileMode.CreateNew, FileAccess.Write, FileShare.None);
+            output.Write(bytes);
+            output.Flush(flushToDisk: true);
+        }
+    }
+}
diff --git a/src/Ryujinx.Graphics.Metal/NativeTimingDiagnostics.cs b/src/Ryujinx.Graphics.Metal/NativeTimingDiagnostics.cs
new file mode 100644
index 0000000000000000000000000000000000000000..6305a739ff709b726bc882586cc64946ff578de0
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/NativeTimingDiagnostics.cs
@@ -0,0 +1,384 @@
+#nullable disable
+using System;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text;
+using System.Threading;
+
+namespace Ryujinx.Graphics.Metal
+{
+    internal enum NativeTimingKind
+    {
+        ShaderLibrary,
+        RenderPipeline,
+        ComputePipeline,
+        NextDrawable,
+        FenceWait,
+        Present,
+        DiagnosticCapture,
+        DiagnosticProgram,
+        DepthSnapshot,
+        CommandCommit,
+        SyncWait,
+        PresentInterval,
+    }
+
+    /// <summary>
+    /// CPU wall-clock intervals only. No Metal timestamp query or process probe.
+    /// The producer holds no renderer lock and never writes files or JSON.
+    /// </summary>
+    internal static class NativeTimingDiagnostics
+    {
+        private const string Variable = "SMASH_COUCH_TIMING_DIR";
+        private static readonly object Initialization = new();
+        private static Recorder _recorder;
+        private static int _initialized;
+        private static int _initializationErrorReported;
+
+        internal static void Initialize()
+        {
+            if (Volatile.Read(ref _initialized) != 0) return;
+            lock (Initialization)
+            {
+                if (_initialized != 0) return;
+                try
+                {
+                    string directory = Environment.GetEnvironmentVariable(Variable);
+                    if (directory != null)
+                        _recorder = new Recorder(ValidateDirectory(directory));
+                }
+                catch (Exception error)
+                {
+                    if (Interlocked.Exchange(ref _initializationErrorReported, 1) == 0)
+                        ReportError(error);
+                }
+                finally
+                {
+                    Volatile.Write(ref _initialized, 1);
+                }
+            }
+        }
+
+        internal static Scope Measure(NativeTimingKind kind)
+        {
+            Initialize();
+            Recorder recorder = Volatile.Read(ref _recorder);
+            return recorder != null && recorder.Active
+                ? new Scope(recorder, kind, Stopwatch.GetTimestamp(), Environment.CurrentManagedThreadId)
+                : default;
+        }
+
+        internal static void PresentInterval()
+        {
+            Initialize();
+            Recorder recorder = Volatile.Read(ref _recorder);
+            if (recorder == null || !recorder.Active) return;
+            try { recorder.PresentInterval(Stopwatch.GetTimestamp(), Environment.CurrentManagedThreadId); }
+            catch (Exception error) { recorder.Disable(error); }
+        }
+
+        internal static void Shutdown()
+        {
+            Recorder recorder = Volatile.Read(ref _recorder);
+            if (recorder == null) return;
+            try { recorder.Shutdown(); }
+            catch (Exception error) { recorder.Disable(error); }
+        }
+
+        internal readonly struct Scope : IDisposable
+        {
+            private readonly Recorder _recorder;
+            private readonly NativeTimingKind _kind;
+            private readonly long _start;
+            private readonly int _thread;
+
+            internal Scope(Recorder recorder, NativeTimingKind kind, long start, int thread)
+            {
+                _recorder = recorder;
+                _kind = kind;
+                _start = start;
+                _thread = thread;
+            }
+
+            public void Dispose()
+            {
+                if (_recorder == null) return;
+                try { _recorder.Record(_kind, _start, Stopwatch.GetTimestamp(), _thread); }
+                catch (Exception error) { _recorder.Disable(error); }
+            }
+        }
+
+        private static string ValidateDirectory(string directory)
+        {
+            string root = Environment.GetEnvironmentVariable("SMASH_COUCH_PRIVATE_DATA");
+            if (string.IsNullOrEmpty(root) || string.IsNullOrEmpty(directory) ||
+                !Path.IsPathFullyQualified(root) || !Path.IsPathFullyQualified(directory))
+                throw new ArgumentException("Timing needs absolute private root and output directory");
+            string normalizedRoot = Path.GetFullPath(root);
+            string normalized = Path.GetFullPath(directory);
+            if (normalizedRoot != root || normalized != directory ||
+                !normalized.StartsWith(normalizedRoot.TrimEnd(Path.DirectorySeparatorChar) +
+                    Path.DirectorySeparatorChar, StringComparison.Ordinal))
+                throw new ArgumentException("Timing directory must be a normalized private-data descendant");
+            for (string cursor = normalized; cursor != null; cursor = Path.GetDirectoryName(cursor))
+            {
+                FileAttributes attributes = File.GetAttributes(cursor);
+                if ((attributes & FileAttributes.ReparsePoint) != 0 ||
+                    (attributes & FileAttributes.Directory) == 0)
+                    throw new ArgumentException("Timing path contains a symlink or non-directory ancestor");
+            }
+            if (Directory.EnumerateFileSystemEntries(normalized).Any())
+                throw new IOException("Timing output directory must be preexisting and fresh (empty)");
+            return normalized;
+        }
+
+        private static void ReportError(Exception error)
+        {
+            try { Console.Error.WriteLine("[NativeTiming] recording disabled: " +
+                error.GetType().Name + ": " + error.Message); }
+            catch { /* Diagnostics must not replace renderer failures. */ }
+        }
+
+        internal readonly record struct DiagnosticSnapshot(
+            long[] Counts, long[] TotalTicks, long Accepted, long Exported,
+            long DroppedQueue, long DroppedLimit, long DroppedError, long DroppedShutdown,
+            long WriterErrors, int QueueDepth);
+
+        internal static DiagnosticSnapshot SnapshotForTests() =>
+            Volatile.Read(ref _recorder)?.Snapshot() ?? default;
+
+        private readonly struct Event
+        {
+            internal readonly NativeTimingKind Kind;
+            internal readonly long Start;
+            internal readonly long End;
+            internal readonly int Thread;
+            internal Event(NativeTimingKind kind, long start, long end, int thread)
+            {
+                Kind = kind;
+                Start = start;
+                End = end;
+                Thread = thread;
+            }
+        }
+
+        internal sealed class Recorder
+        {
+            private const int QueueLimit = 8192;
+            private const long ExportLimit = 100000;
+            private static readonly long ThresholdTicks = Math.Max(1, Stopwatch.Frequency / 250);
+            private readonly Event[] _queue = new Event[QueueLimit];
+            private readonly object _gate = new();
+            private readonly long[] _counts = new long[Enum.GetValues<NativeTimingKind>().Length];
+            private readonly long[] _totalTicks = new long[Enum.GetValues<NativeTimingKind>().Length];
+            private readonly FileStream _file;
+            private readonly Thread _writer;
+            private readonly DateTime _startedUtc = DateTime.UtcNow;
+            private readonly long _startedTicks = Stopwatch.GetTimestamp();
+            private int _head, _tail, _queueCount, _active = 1, _shutdown;
+            private long _lastPresent, _accepted, _exported, _dropQueue, _dropLimit;
+            private long _dropError, _dropShutdown, _writerErrors;
+            private int _errorReported;
+
+            internal bool Active => Volatile.Read(ref _active) != 0;
+
+            internal Recorder(string directory)
+            {
+                _file = new FileStream(Path.Combine(directory, "native-timing.jsonl"),
+                    FileMode.CreateNew, FileAccess.Write, FileShare.Read);
+                _writer = new Thread(WriteLoop) { IsBackground = true, Name = "native-timing-writer" };
+                try { _writer.Start(); }
+                catch
+                {
+                    _file.Dispose();
+                    throw;
+                }
+            }
+
+            internal void Record(NativeTimingKind kind, long start, long end, int thread)
+            {
+                long duration = Math.Max(0, end - start);
+                int index = (int)kind;
+                Interlocked.Increment(ref _counts[index]);
+                Interlocked.Add(ref _totalTicks[index], duration);
+                if (kind != NativeTimingKind.Present && kind != NativeTimingKind.PresentInterval &&
+                    duration < ThresholdTicks) return;
+                Enqueue(new Event(kind, start, end, thread));
+            }
+
+            internal void PresentInterval(long now, int thread)
+            {
+                long previous = Interlocked.Exchange(ref _lastPresent, now);
+                Record(NativeTimingKind.PresentInterval, previous == 0 ? now : previous, now, thread);
+            }
+
+            private void Enqueue(Event item)
+            {
+                if (!Active)
+                {
+                    DropStopped();
+                    return;
+                }
+                lock (_gate)
+                {
+                    if (_active == 0)
+                    {
+                        DropStopped();
+                    }
+                    else if (_accepted >= ExportLimit)
+                    {
+                        Interlocked.Increment(ref _dropLimit);
+                    }
+                    else if (_queueCount == QueueLimit)
+                    {
+                        Interlocked.Increment(ref _dropQueue);
+                    }
+                    else
+                    {
+                        _queue[_tail] = item;
+                        _tail = (_tail + 1) % QueueLimit;
+                        _queueCount++;
+                        _accepted++;
+                    }
+                }
+            }
+
+            private void DropStopped()
+            {
+                if (Interlocked.Read(ref _writerErrors) != 0)
+                    Interlocked.Increment(ref _dropError);
+                else
+                    Interlocked.Increment(ref _dropShutdown);
+            }
+
+            private bool TryDequeue(out Event item)
+            {
+                lock (_gate)
+                {
+                    if (_queueCount == 0) { item = default; return false; }
+                    item = _queue[_head];
+                    _head = (_head + 1) % QueueLimit;
+                    _queueCount--;
+                    return true;
+                }
+            }
+
+            internal DiagnosticSnapshot Snapshot()
+            {
+                long[] counts = new long[_counts.Length], totals = new long[_totalTicks.Length];
+                for (int i = 0; i < counts.Length; i++)
+                {
+                    counts[i] = Interlocked.Read(ref _counts[i]);
+                    totals[i] = Interlocked.Read(ref _totalTicks[i]);
+                }
+                lock (_gate)
+                    return new DiagnosticSnapshot(counts, totals, _accepted,
+                        Interlocked.Read(ref _exported), Interlocked.Read(ref _dropQueue),
+                        Interlocked.Read(ref _dropLimit), Interlocked.Read(ref _dropError),
+                        Interlocked.Read(ref _dropShutdown), Interlocked.Read(ref _writerErrors),
+                        _queueCount);
+            }
+
+            private void WriteLoop()
+            {
+                bool inFlight = false;
+                try
+                {
+                    using StreamWriter output = new(_file, new UTF8Encoding(false));
+                    output.WriteLine("{\"record\":\"header\",\"schema\":\"native-timing-v1\",\"utc\":\"" +
+                        _startedUtc.ToString("O", CultureInfo.InvariantCulture) +
+                        "\",\"stopwatch_frequency\":" + Stopwatch.Frequency.ToString(CultureInfo.InvariantCulture) +
+                        ",\"start_ticks\":" + _startedTicks.ToString(CultureInfo.InvariantCulture) +
+                        ",\"queue_limit\":8192,\"event_limit\":100000," +
+                        "\"meaning\":\"CPU elapsed scopes and Present entry cadence, not GPU completion/display presentation; deadline termination may omit the final second\"," +
+                        "\"coherency\":\"periodic aggregates are nontransactional across producer threads; final follows queue drain\"}");
+                    output.Flush();
+                    long lastSummary = Stopwatch.GetTimestamp();
+                    while (true)
+                    {
+                        int drained = 0;
+                        while (drained < 512 && TryDequeue(out Event item))
+                        {
+                            inFlight = true;
+                            long duration = Math.Max(0, item.End - item.Start);
+                            output.WriteLine("{\"record\":\"event\",\"kind\":\"" + item.Kind +
+                                "\",\"start_ticks\":" + (item.Start - _startedTicks).ToString(CultureInfo.InvariantCulture) +
+                                ",\"end_ticks\":" + (item.End - _startedTicks).ToString(CultureInfo.InvariantCulture) +
+                                ",\"duration_ticks\":" + duration.ToString(CultureInfo.InvariantCulture) +
+                                ",\"managed_thread\":" + item.Thread.ToString(CultureInfo.InvariantCulture) + "}");
+                            Interlocked.Increment(ref _exported);
+                            inFlight = false;
+                            drained++;
+                        }
+                        long now = Stopwatch.GetTimestamp();
+                        bool summarized = false;
+                        if (now - lastSummary >= Stopwatch.Frequency || Volatile.Read(ref _shutdown) != 0)
+                        {
+                            bool final = Volatile.Read(ref _shutdown) != 0 && Snapshot().QueueDepth == 0;
+                            WriteSummary(output, final);
+                            lastSummary = now;
+                            summarized = true;
+                        }
+                        if (drained != 0 || summarized) output.Flush();
+                        if (Volatile.Read(ref _shutdown) != 0 && Snapshot().QueueDepth == 0) break;
+                        if (drained == 0) Thread.Sleep(100);
+                    }
+                }
+                catch (Exception error)
+                {
+                    if (inFlight) Interlocked.Increment(ref _dropError);
+                    Disable(error);
+                }
+            }
+
+            private void WriteSummary(StreamWriter output, bool final)
+            {
+                DiagnosticSnapshot s = Snapshot();
+                StringBuilder line = new(640);
+                line.Append("{\"record\":\"summary\",\"final\":").Append(final ? "true" : "false")
+                    .Append(",\"elapsed_ticks\":")
+                    .Append((Stopwatch.GetTimestamp() - _startedTicks).ToString(CultureInfo.InvariantCulture))
+                    .Append(",\"accepted\":").Append(s.Accepted)
+                    .Append(",\"exported\":").Append(s.Exported)
+                    .Append(",\"dropped_queue\":").Append(s.DroppedQueue)
+                    .Append(",\"dropped_limit\":").Append(s.DroppedLimit)
+                    .Append(",\"dropped_error\":").Append(s.DroppedError)
+                    .Append(",\"dropped_shutdown\":").Append(s.DroppedShutdown)
+                    .Append(",\"writer_errors\":").Append(s.WriterErrors)
+                    .Append(",\"queue_depth\":").Append(s.QueueDepth)
+                    .Append(",\"aggregates\":{");
+                for (int i = 0; i < s.Counts.Length; i++)
+                {
+                    if (i != 0) line.Append(',');
+                    line.Append('"').Append((NativeTimingKind)i).Append("\":{\"count\":")
+                        .Append(s.Counts[i]).Append(",\"total_ticks\":").Append(s.TotalTicks[i]).Append('}');
+                }
+                line.Append("}}");
+                output.WriteLine(line);
+            }
+
+            internal void Shutdown()
+            {
+                Interlocked.Exchange(ref _shutdown, 1);
+                Volatile.Write(ref _active, 0);
+                if (Thread.CurrentThread != _writer) _writer.Join(1000);
+            }
+
+            internal void Disable(Exception error)
+            {
+                Volatile.Write(ref _active, 0);
+                Volatile.Write(ref _shutdown, 1);
+                Interlocked.Increment(ref _writerErrors);
+                lock (_gate)
+                {
+                    Interlocked.Add(ref _dropError, _queueCount);
+                    _queueCount = 0;
+                    _head = _tail;
+                }
+                if (Interlocked.Exchange(ref _errorReported, 1) == 0) ReportError(error);
+            }
+        }
+    }
+}
diff --git a/src/Ryujinx.Graphics.Metal/NumericVertexInterface.cs b/src/Ryujinx.Graphics.Metal/NumericVertexInterface.cs
new file mode 100644
index 0000000000000000000000000000000000000000..2e8bf794249307ba6818983e7d9eeae01b3ebd93
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/NumericVertexInterface.cs
@@ -0,0 +1,208 @@
+using Ryujinx.Graphics.GAL;
+using Ryujinx.Graphics.Shader;
+using Ryujinx.Graphics.Shader.Translation;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // This is an explicit host-domain compatibility choice, not a claim about
+    // guest NaN colors. Metal forbids nonfinite numeric interpolants. Only exact
+    // compiler-classified producer/consumer components are admitted. Guest math,
+    // finite values, builtins and raw-bit/flat/unknown interfaces are unchanged.
+    // The caller MUST compile with Safe/Precise (FastMathEnabled=false).
+    internal static class NumericVertexInterface
+    {
+        private const string Helper = "couch_numeric_vertex_exit_v1";
+        private readonly record struct Token(string Text, int Start, int End);
+        private readonly record struct Edit(int Start, int End, string Text);
+        internal static string Sha(string source) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(source)));
+
+        internal static ShaderSource[] Adapt(ShaderSource[] sources, out string receipt)
+        {
+            receipt = null;
+            if (sources.Length != 2 || sources.Any(s => s.Language != TargetLanguage.Msl || s.Code == null)) return sources;
+            int vertex = Array.FindIndex(sources, s => s.Stage == ShaderStage.Vertex);
+            int fragment = Array.FindIndex(sources, s => s.Stage == ShaderStage.Fragment);
+            if (vertex < 0 || fragment < 0) return sources;
+            MslNumericVaryingFacts producer = sources[vertex].NumericVaryings;
+            MslNumericVaryingFacts consumer = sources[fragment].NumericVaryings;
+            if (producer == null || consumer == null ||
+                !producer.Matches(sources[vertex].Code, ShaderStage.Vertex) ||
+                !consumer.Matches(sources[fragment].Code, ShaderStage.Fragment)) return sources;
+
+            var selections = new SortedDictionary<int, string>();
+            for (int location = 0; location < 32; location++)
+            {
+                int mask = producer.GetComponentMask(location) & consumer.GetComponentMask(location);
+                if (mask != 0)
+                    selections.Add(location, new string("xyzw".Where((_, index) => (mask & (1 << index)) != 0).ToArray()));
+            }
+            if (selections.Count == 0) return sources;
+            string adapted = RewriteSelectedNumericComponents(sources[vertex].Code, sources[fragment].Code,
+                selections, out int exits);
+            ShaderSource[] result = (ShaderSource[])sources.Clone();
+            // The original compiler facts do not describe rewritten code.
+            result[vertex] = new ShaderSource(adapted, sources[vertex].BinaryCode, ShaderStage.Vertex, TargetLanguage.Msl);
+            string components = string.Join(",", selections.Select(s => $"outAttr{s.Key}.{s.Value}"));
+            receipt = $"NumericVertexInterface:v2 eligibility=typed-IR-components policy=nonfinite-to-positive-zero components={components} " +
+                $"originalVertex={producer.SourceSha256} originalFragment={consumer.SourceSha256} adaptedVertex={Sha(adapted)} " +
+                $"adaptedFragment={consumer.SourceSha256} entrypointExits={exits} math=Safe/Precise guestArithmetic=unchanged";
+            return result;
+        }
+
+        // An internal CPU/native regression seam, not a runtime configuration or
+        // broader admission rule. Production requires paired, source-bound compiler facts.
+        internal static string RewriteKnownNumericPair(string vertex, string fragment, int location,
+            string components, out int exitCount)
+        {
+            return RewriteSelectedNumericComponents(vertex, fragment,
+                new SortedDictionary<int, string> { [location] = components }, out exitCount);
+        }
+
+        private static string RewriteSelectedNumericComponents(string vertex, string fragment,
+            IReadOnlyDictionary<int, string> selections, out int exitCount)
+        {
+            if (selections.Count == 0 || selections.Any(s => s.Key < 0 || s.Key >= 32 || s.Value.Length == 0 ||
+                    s.Value.Distinct().Count() != s.Value.Length || s.Value.Any(c => !"xyzw".Contains(c))) ||
+                vertex.Contains(Helper, StringComparison.Ordinal) || fragment.Contains(Helper, StringComparison.Ordinal))
+                throw new InvalidOperationException("Unsupported numeric interface policy or already adapted shader.");
+            List<Token> vt = Lex(vertex), ft = Lex(fragment);
+            (int vOpen, int vClose) = Struct(vt, "VertexOut");
+            (int fOpen, int fClose) = Struct(ft, "FragmentIn");
+            foreach (int location in selections.Keys)
+            {
+                VerifyField(vt, vOpen, vClose, "outAttr" + location, "loc" + location);
+                VerifyField(ft, fOpen, fClose, "inAttr" + location, "loc" + location);
+            }
+
+            int entry = Unique(vt, ["vertex", "VertexOut", "vertexMain", "("]);
+            int argsClose = Match(vt, entry + 3, "(", ")");
+            if (argsClose + 1 >= vt.Count || vt[argsClose + 1].Text != "{")
+                throw new InvalidOperationException("Unsupported vertex entrypoint declaration.");
+            int mainOpen = argsClose + 1, mainClose = Match(vt, mainOpen, "{", "}");
+            if (vClose >= entry) throw new InvalidOperationException("VertexOut must precede the vertex entrypoint.");
+            var edits = new List<Edit>();
+            for (int i = mainOpen + 1; i < mainClose; i++)
+            {
+                if (vt[i].Text != "return") continue;
+                if (i + 2 >= mainClose || vt[i + 1].Text != "out" || vt[i + 2].Text != ";")
+                    throw new InvalidOperationException("Unsupported vertex entrypoint return; no partial adaptation.");
+                edits.Add(new Edit(vt[i].Start, vt[i + 2].End, "return " + Helper + "(out);"));
+                i += 2;
+            }
+            exitCount = edits.Count;
+            if (exitCount == 0) throw new InvalidOperationException("No explicit generated vertex exits to adapt.");
+
+            var helper = new StringBuilder("\n\n// Couch numeric interface v1: only an inspected undefined host domain is canonicalized.\n");
+            helper.Append("inline VertexOut ").Append(Helper).Append("(VertexOut value)\n{\n");
+            foreach (var selection in selections)
+            {
+                foreach (char component in selection.Value)
+                {
+                    string field = $"value.outAttr{selection.Key}.{component}";
+                    helper.Append("    ").Append(field).Append(" = isfinite(").Append(field).Append(") ? ")
+                        .Append(field).Append(" : 0.0f;\n");
+                }
+            }
+            helper.Append("    return value;\n}\n");
+            edits.Add(new Edit(vt[vClose + 1].End, vt[vClose + 1].End, helper.ToString()));
+            var result = new StringBuilder(vertex);
+            foreach (Edit edit in edits.OrderByDescending(e => e.Start))
+            {
+                result.Remove(edit.Start, edit.End - edit.Start);
+                result.Insert(edit.Start, edit.Text);
+            }
+            return result.ToString();
+        }
+
+        private static (int Open, int Close) Struct(List<Token> tokens, string name)
+        {
+            int start = Unique(tokens, ["struct", name, "{"]);
+            int close = Match(tokens, start + 2, "{", "}");
+            if (close + 1 >= tokens.Count || tokens[close + 1].Text != ";")
+                throw new InvalidOperationException("Unsupported interface struct terminator.");
+            return (start + 2, close);
+        }
+
+        private static void VerifyField(List<Token> tokens, int open, int close, string name, string location)
+        {
+            string[] declaration = ["float4", name, "[", "[", "user", "(", location, ")", "]", "]", ";"];
+            int matches = 0;
+            for (int i = open + 1; i < close; i++)
+            {
+                if (tokens[i].Text != name) continue;
+                if (i < 2 || (tokens[i - 2].Text != "{" && tokens[i - 2].Text != ";") ||
+                    i + declaration.Length - 1 > close ||
+                    !declaration.Select((v, n) => tokens[i - 1 + n].Text == v).All(v => v))
+                    throw new InvalidOperationException("Unknown, non-float, flat or qualified numeric interface field.");
+                matches++;
+            }
+            if (matches != 1) throw new InvalidOperationException("Numeric interface field is missing or duplicated.");
+        }
+
+        private static int Unique(List<Token> tokens, string[] sequence)
+        {
+            int result = -1;
+            for (int i = 0; i <= tokens.Count - sequence.Length; i++)
+            {
+                if (!sequence.Select((v, n) => tokens[i + n].Text == v).All(v => v)) continue;
+                if (result != -1) throw new InvalidOperationException("Ambiguous generated shader structure.");
+                result = i;
+            }
+            return result >= 0 ? result : throw new InvalidOperationException("Expected generated shader structure is absent.");
+        }
+
+        private static int Match(List<Token> tokens, int open, string left, string right)
+        {
+            if (tokens[open].Text != left) throw new InvalidOperationException("Invalid shader scope opening.");
+            int depth = 0;
+            for (int i = open; i < tokens.Count; i++)
+            {
+                if (tokens[i].Text == left) depth++;
+                if (tokens[i].Text == right && --depth == 0) return i;
+            }
+            throw new InvalidOperationException("Unbalanced generated shader scope.");
+        }
+
+        private static List<Token> Lex(string source)
+        {
+            var result = new List<Token>();
+            for (int i = 0; i < source.Length;)
+            {
+                if (char.IsWhiteSpace(source[i])) { i++; continue; }
+                if (i + 1 < source.Length && source[i] == '/' && source[i + 1] == '/')
+                {
+                    int end = source.IndexOf('\n', i + 2); i = end < 0 ? source.Length : end + 1; continue;
+                }
+                if (i + 1 < source.Length && source[i] == '/' && source[i + 1] == '*')
+                {
+                    int end = source.IndexOf("*/", i + 2, StringComparison.Ordinal);
+                    if (end < 0) throw new InvalidOperationException("Unterminated shader comment.");
+                    i = end + 2; continue;
+                }
+                int start = i++;
+                if (source[start] == '"' || source[start] == '\'')
+                {
+                    char quote = source[start]; bool ended = false;
+                    while (i < source.Length)
+                    {
+                        char next = source[i++];
+                        if (next == '\\') { if (i < source.Length) i++; continue; }
+                        if (next == quote) { ended = true; break; }
+                    }
+                    if (!ended) throw new InvalidOperationException("Unterminated shader literal.");
+                }
+                else if (char.IsLetterOrDigit(source[start]) || source[start] == '_')
+                {
+                    while (i < source.Length && (char.IsLetterOrDigit(source[i]) || source[i] == '_')) i++;
+                }
+                result.Add(new Token(source[start..i], start, i));
+            }
+            return result;
+        }
+    }
+}
