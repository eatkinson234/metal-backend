+
+        private static Dictionary<string, object> NativeTextureRecord(MTLTexture texture)
+        {
+            Dictionary<string, object> record = new()
+            {
+                ["nativePointer"] = Pointer(texture.NativePtr),
+                ["queried"] = false,
+            };
+            if (texture.NativePtr == IntPtr.Zero) return record;
+
+            try
+            {
+                record["queried"] = true;
+                record["gpuResourceId"] = texture.GpuResourceID._impl;
+                record["textureType"] = texture.TextureType.ToString();
+                record["pixelFormat"] = texture.PixelFormat.ToString();
+                record["width"] = texture.Width;
+                record["height"] = texture.Height;
+                record["depth"] = texture.Depth;
+                record["sampleCount"] = texture.SampleCount;
+                record["mipmapLevelCount"] = texture.MipmapLevelCount;
+                record["arrayLength"] = texture.ArrayLength;
+                record["storageMode"] = texture.StorageMode.ToString();
+                record["hazardTrackingMode"] = texture.HazardTrackingMode.ToString();
+                // Label is borrowed. Copy UTF-8 while the texture/pool is alive;
+                // the old helper undersized a UTF-16 getCString buffer.
+                NSString label = texture.Label;
+                record["label"] = label.NativePtr == IntPtr.Zero ? null :
+                    Marshal.PtrToStringUTF8(ObjectiveC.IntPtr_objc_msgSend(label.NativePtr, "UTF8String"));
+            }
+            catch (Exception failure)
+            {
+                record["queryFailure"] = $"{failure.GetType().Name}: {failure.Message}";
+            }
+            return record;
+        }
+
+        private static bool TryEncodeProgram(ShaderSource[] shaders, ResourceLayout layout,
+            out string identity, out List<Dictionary<string, object>> shaderRecords,
+            out List<(string Name, byte[] Bytes)> shaderFiles, out byte[] layoutBytes,
+            out int sourceBytes, out string failure)
+        {
+            identity = null;
+            shaderRecords = [];
+            shaderFiles = [];
+            layoutBytes = [];
+            sourceBytes = 0;
+            failure = null;
+
+            if (shaders == null || layout.SetUsages == null)
+            {
+                failure = "program-or-layout-missing";
+                return false;
+            }
+
+            foreach (ShaderSource shader in shaders.OrderBy(shader => shader.Stage))
+            {
+                byte[] code = Encoding.UTF8.GetBytes(shader.Code ?? string.Empty);
+                if (code.Length > MaximumShaderSourceBytes - sourceBytes)
+                {
+                    failure = "program-shader-source-exceeds-per-program-byte-quota";
+                    return false;
+                }
+                sourceBytes += code.Length;
+                string codeHash = Sha256(code);
+                string fileName = $"{shader.Stage}.metal";
+                shaderFiles.Add((fileName, code));
+                shaderRecords.Add(new Dictionary<string, object>
+                {
+                    ["stage"] = shader.Stage.ToString(),
+                    ["entryPoint"] = shader.Stage switch
+                    {
+                        ShaderStage.Vertex => "vertexMain",
+                        ShaderStage.Fragment => "fragmentMain",
+                        ShaderStage.Compute => "kernelMain",
+                        _ => "unsupported",
+                    },
+                    ["file"] = fileName,
+                    ["utf8Bytes"] = code.Length,
+                    ["sha256"] = codeHash,
+                });
+            }
+
+            List<Dictionary<string, object>> sets = [];
+            for (int set = 0; set < layout.SetUsages.Count; set++)
+            {
+                List<Dictionary<string, object>> usages = [];
+                foreach (ResourceUsage usage in layout.SetUsages[set].Usages)
+                {
+                    usages.Add(new Dictionary<string, object>
+                    {
+                        ["binding"] = usage.Binding,
+                        ["arrayLength"] = usage.ArrayLength,
+                        ["type"] = usage.Type.ToString(),
+                        ["stages"] = usage.Stages.ToString(),
+                        ["write"] = usage.Write,
+                    });
+                }
+                sets.Add(new Dictionary<string, object> { ["set"] = set, ["usages"] = usages });
+            }
+            layoutBytes = JsonSerializer.SerializeToUtf8Bytes(sets, JsonOptions);
+
+            using IncrementalHash digest = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
+            foreach (Dictionary<string, object> shader in shaderRecords)
+            {
+                AppendHash(digest, (string)shader["stage"]);
+                AppendHash(digest, (string)shader["sha256"]);
+            }
+            AppendHash(digest, Sha256(layoutBytes));
+            identity = Convert.ToHexString(digest.GetHashAndReset());
+            return true;
+        }
+
+        private static bool TryEncodeRetainedProgram(Program.FeedbackShaderSource[] retainedShaders,
+            Program.FeedbackResourceUsage[] retainedUsages, int setCount,
+            out string identity, out List<Dictionary<string, object>> shaderRecords,
+            out List<(string Name, byte[] Bytes)> shaderFiles, out byte[] layoutBytes,
+            out int sourceBytes, out string failure)
+        {
+            identity = null;
+            shaderRecords = [];
+            shaderFiles = [];
+            layoutBytes = [];
+            sourceBytes = 0;
+            failure = null;
+
+            if (retainedShaders == null || retainedUsages == null || setCount < 0)
+            {
+                failure = "first-binding-retained-program-metadata-missing";
+                return false;
+            }
+
+            List<ResourceUsage>[] usagesBySet = new List<ResourceUsage>[setCount];
+            for (int set = 0; set < setCount; set++) usagesBySet[set] = [];
+            foreach (Program.FeedbackResourceUsage retained in retainedUsages)
+            {
+                if ((uint)retained.Set >= (uint)setCount)
+                {
+                    failure = "first-binding-retained-resource-set-out-of-range";
+                    return false;
+                }
+
+                usagesBySet[retained.Set].Add(new ResourceUsage(
+                    retained.Binding, retained.ArrayLength, retained.Type, retained.Stages, retained.Write));
+            }
+
+            ShaderSource[] shaders = retainedShaders
+                .Select(shader => new ShaderSource(shader.Code, shader.Stage, TargetLanguage.Msl))
+                .ToArray();
+            ResourceUsageCollection[] setUsages = new ResourceUsageCollection[setCount];
+            ResourceDescriptorCollection[] descriptors = new ResourceDescriptorCollection[setCount];
+            for (int set = 0; set < setCount; set++)
+            {
+                ResourceUsage[] usages = usagesBySet[set].ToArray();
+                ResourceDescriptor[] setDescriptors = usages
+                    .Select(usage => new ResourceDescriptor(
+                        usage.Binding, usage.ArrayLength, usage.Type, usage.Stages))
+                    .ToArray();
+                setUsages[set] = new ResourceUsageCollection(Array.AsReadOnly(usages));
+                descriptors[set] = new ResourceDescriptorCollection(Array.AsReadOnly(setDescriptors));
+            }
+
+            ResourceLayout layout = new(Array.AsReadOnly(descriptors), Array.AsReadOnly(setUsages));
+            return TryEncodeProgram(shaders, layout, out identity, out shaderRecords,
+                out shaderFiles, out layoutBytes, out sourceBytes, out failure);
+        }
+
+        private static void AppendHash(IncrementalHash hash, string value)
+        {
+            byte[] bytes = Encoding.UTF8.GetBytes(value);
+            hash.AppendData(bytes);
+            hash.AppendData([0]);
+        }
+
+        private static bool EnsureEvidenceDirectory()
+        {
+            if (_pathChecked) return _directory != null;
+            _pathChecked = true;
+
+            string configured = Environment.GetEnvironmentVariable(EvidenceDirectoryVariable);
+            string[] arguments = Environment.GetCommandLineArgs();
+            int rootSwitch = Array.IndexOf(arguments, "-r");
+            if (rootSwitch < 0 || rootSwitch + 1 >= arguments.Length)
+            {
+                _pathFailure = "cube evidence requires the actual private -r data path";
+                return false;
+            }
+
+            string lab = Path.GetFullPath(Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
+                "Library", "Application Support", "Smash Couch", "Lab"));
+            if (!IsPrivateEvidenceDirectory(configured, arguments[rootSwitch + 1], lab,
+                    out _directory, out _pathFailure))
+            {
+                _directory = null;
+                return false;
+            }
+            return true;
+        }
+
+        private static bool WriteNewFile(string relativePath, byte[] bytes, bool source)
+        {
+            if (_captureDisabled || !EnsureEvidenceDirectory()) return false;
+            int sourceNext = source ? _shaderSourceBytes + bytes.Length : _shaderSourceBytes;
+            int metadataNext = source ? _metadataBytes : _metadataBytes + bytes.Length;
+            if (sourceNext > MaximumShaderSourceBytes || metadataNext > MaximumMetadataBytes ||
+                !FitsQuota(_totalBytes, bytes.Length, MaximumTotalBytes - LimitReceiptReserve))
+            {
+                WriteLimitReceipt(sourceNext > MaximumShaderSourceBytes
+                    ? "shader-source-byte-quota-exhausted"
+                    : metadataNext > MaximumMetadataBytes
+                        ? "metadata-byte-quota-exhausted"
+                        : "total-byte-quota-exhausted");
+                return false;
+            }
+
+            string destination = Path.GetFullPath(Path.Combine(_directory, relativePath));
+            string prefix = _directory.TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
+            if (!destination.StartsWith(prefix, StringComparison.Ordinal))
+            {
+                WriteLimitReceipt("capture-path-escaped-evidence-directory");
+                return false;
+            }
+
+            string parent = Path.GetDirectoryName(destination);
+            Directory.CreateDirectory(parent);
+            using FileStream file = new(destination, FileMode.CreateNew, FileAccess.Write, FileShare.Read);
+            file.Write(bytes);
+            file.Flush(flushToDisk: true);
+            _totalBytes += bytes.Length;
+            if (source) _shaderSourceBytes += bytes.Length;
+            else _metadataBytes += bytes.Length;
+            return true;
+        }
+
+        private static void WriteLimitReceipt(string reason)
+        {
+            if (_limitReceiptWritten) return;
+            _limitReceiptWritten = true;
+            _captureDisabled = true;
+            if (!EnsureEvidenceDirectory() || _directory == null) return;
+
+            try
+            {
+                byte[] bytes = JsonSerializer.SerializeToUtf8Bytes(new Dictionary<string, object>
+                {
+                    ["schema"] = "smash-couch-cube-capture-limit-v1",
+                    ["capturedUtc"] = DateTimeOffset.UtcNow,
+                    ["reason"] = reason,
+                    ["maximumPrograms"] = MaximumProgramCount,
+                    ["maximumBindingRecords"] = MaximumBindingRecordCount,
+                    ["maximumShaderSourceBytes"] = MaximumShaderSourceBytes,
+                    ["maximumMetadataBytes"] = MaximumMetadataBytes,
+                    ["maximumTotalBytes"] = MaximumTotalBytes,
+                    ["programsCaptured"] = ProgramIdentities.Count,
+                    ["bindingRecordsCaptured"] = BindingIdentities.Count,
+                    ["shaderSourceBytesCaptured"] = _shaderSourceBytes,
+                    ["metadataBytesCaptured"] = _metadataBytes,
+                    ["totalBytesCaptured"] = _totalBytes,
+                }, JsonOptions);
+                if (FitsQuota(_totalBytes, bytes.Length, MaximumTotalBytes))
+                {
+                    using FileStream file = new(Path.Combine(_directory, "capture-limit.json"),
+                        FileMode.CreateNew, FileAccess.Write, FileShare.Read);
+                    file.Write(bytes);
+                    file.Flush(flushToDisk: true);
+                    _totalBytes += bytes.Length;
+                }
+            }
+            catch
+            {
+                // Quota reporting cannot affect graphics work.
+            }
+        }
+
+        private static void NoteLimit(string reason)
+        {
+            lock (Gate)
+            {
+                WriteLimitReceipt(reason);
+                _captureDisabled = true;
+            }
+        }
+
+        private static void DisableCapture(string reason, Exception failure)
+        {
+            lock (Gate)
+            {
+                if (_captureDisabled) return;
+                WriteLimitReceipt($"{reason}:{failure.GetType().Name}:{failure.Message}");
+                _captureDisabled = true;
+            }
+        }
+
+        private static string Sha256(byte[] bytes) => Convert.ToHexString(SHA256.HashData(bytes));
+        private static string Pointer(IntPtr value) => $"0x{(ulong)value:X}";
+        private static JsonSerializerOptions JsonOptions => new() { WriteIndented = true };
+    }
+}
diff --git a/src/Ryujinx.Graphics.Metal/DepthFeedbackSnapshot.cs b/src/Ryujinx.Graphics.Metal/DepthFeedbackSnapshot.cs
new file mode 100644
index 0000000000000000000000000000000000000000..966af4dd4bfba67bf4a6b3ad966bafdd599468cc
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/DepthFeedbackSnapshot.cs
@@ -0,0 +1,107 @@
+using SharpMetal.Metal;
+using SharpMetal.ObjectiveCCore;
+using System;
+using System.Collections.Generic;
+using System.Runtime.Versioning;
+using System.Threading;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // Auto<DepthFeedbackSnapshot> holds the native objects through the command
+    // buffer fence. A sampled source can have three different native objects:
+    // its swizzled sampling view, its identity copy view, and the parent root.
+    // Keep every distinct handle alive until the copy/draw command buffer fence.
+    [SupportedOSPlatform("macos")]
+    internal sealed class DepthFeedbackSnapshot : IDisposable
+    {
+        // Isolated fixture seam. Unset for ordinary renderer-created programs;
+        // lets the fixture fail after command-buffer ownership transfer and
+        // verify that the source/root/view survive until fence consumption.
+        internal static Action<object> BeforeCopyTestHook;
+        internal static Action<object> AfterCopyTestHook;
+
+        private Texture _snapshot;
+        private readonly List<MTLTexture> _retainedSourceHandles = new(3);
+        private int _disposed;
+
+        internal Texture Texture => _snapshot;
+
+        internal DepthFeedbackSnapshot(Texture snapshot, MTLTexture borrowedSourceSampling,
+            MTLTexture borrowedSourceIdentity, IntPtr borrowedRoot)
+        {
+            if (borrowedSourceSampling.NativePtr == IntPtr.Zero ||
+                borrowedSourceIdentity.NativePtr == IntPtr.Zero || borrowedRoot == IntPtr.Zero)
+                throw new ArgumentException("Depth snapshot source handles must be valid.", nameof(borrowedSourceSampling));
+
+            _snapshot = snapshot ?? throw new ArgumentNullException(nameof(snapshot));
+            try
+            {
+                RetainUnique(borrowedSourceSampling);
+                RetainUnique(borrowedSourceIdentity);
+                RetainUnique(new MTLTexture(borrowedRoot));
+            }
+            catch
+            {
+                try { ReleaseSourceHandles(); }
+                catch { }
+                _snapshot = null;
+                throw;
+            }
+        }
+
+        private void RetainUnique(MTLTexture handle)
+        {
+            if (handle.NativePtr == IntPtr.Zero)
+                throw new ArgumentException("Depth snapshot source handle is invalid.", nameof(handle));
+
+            foreach (MTLTexture retained in _retainedSourceHandles)
+            {
+                if (retained.NativePtr == handle.NativePtr)
+                    return;
+            }
+
+            ObjectiveC.IntPtr_objc_msgSend(handle.NativePtr, "retain");
+            _retainedSourceHandles.Add(handle);
+        }
+
+        private Exception ReleaseSourceHandles()
+        {
+            Exception failure = null;
+            for (int index = _retainedSourceHandles.Count - 1; index >= 0; index--)
+            {
+                MTLTexture handle = _retainedSourceHandles[index];
+                _retainedSourceHandles.RemoveAt(index);
+                try
+                {
+                    handle.Dispose();
+                }
+                catch (Exception exception)
+                {
+                    failure ??= exception;
+                }
+            }
+            return failure;
+        }
+
+        public void Dispose()
+        {
+            if (Interlocked.Exchange(ref _disposed, 1) != 0) return;
+            Exception failure = null;
+            try
+            {
+                _snapshot?.Release();
+            }
+            catch (Exception exception)
+            {
+                failure = exception;
+            }
+            finally
+            {
+                _snapshot = null;
+                Exception sourceFailure = ReleaseSourceHandles();
+                failure ??= sourceFailure;
+            }
+            if (failure != null) throw failure;
+        }
+    }
+}
diff --git a/src/Ryujinx.Graphics.Metal/DepthSnapshotAdmissionEvidence.cs b/src/Ryujinx.Graphics.Metal/DepthSnapshotAdmissionEvidence.cs
new file mode 100644
index 0000000000000000000000000000000000000000..09fee4f97945c4e7f803869318eb7fe225ed7b7e
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/DepthSnapshotAdmissionEvidence.cs
@@ -0,0 +1,213 @@
+using SharpMetal.Metal;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using System.Threading;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // One-shot evidence for a recovered feedback guard stop only. Preparation
+    // stores a small in-memory reason per draw; this class performs no I/O until
+    // a bounded Main-state depth alias is rejected by the guard. This is optional
+    // evidence only; it cannot change rendering admission or suppress the guard.
+    internal static class DepthSnapshotAdmissionEvidence
+    {
+        private const string Variable = "SMASH_COUCH_DEPTH_SNAPSHOT_ADMISSION_EVIDENCE_DIR";
+        private static int _claimed;
+
+        internal static void TryCapture(string context, Program program,
+            string firstRejectedPredicate, RenderFeedbackGuard.FeedbackGuardException failure)
+        {
+            string configured = Environment.GetEnvironmentVariable(Variable);
+            if (string.IsNullOrWhiteSpace(configured) || program == null ||
+                failure?.Evidence is not RenderFeedbackGuard.FailureEvidence evidence ||
+                !IsRecoveredDepthAlias(evidence) ||
+                Interlocked.CompareExchange(ref _claimed, 1, 0) != 0)
+                return;
+
+            try
+            {
+                string directory = Path.GetFullPath(configured);
+                string lab = Path.GetFullPath(Path.Combine(
+                    Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
+                    "Library", "Application Support", "Smash Couch", "Lab"));
+                string prefix = lab + Path.DirectorySeparatorChar;
+                string[] arguments = Environment.GetCommandLineArgs();
+                int dataSwitch = Array.IndexOf(arguments, "-r");
+                if (dataSwitch < 0 || dataSwitch + 1 >= arguments.Length)
+                    throw new IOException("Admission evidence requires the actual private -r data path.");
+                string data = Path.GetFullPath(arguments[dataSwitch + 1]);
+                if (!directory.StartsWith(prefix, StringComparison.Ordinal) ||
+                    !data.StartsWith(prefix, StringComparison.Ordinal) ||
+                    !directory.StartsWith(data + Path.DirectorySeparatorChar, StringComparison.Ordinal) ||
+                    !Directory.Exists(directory) || !Directory.Exists(lab) || !Directory.Exists(data))
+                    throw new IOException("Admission evidence must be a preexisting private Lab descendant.");
+
+                string current = directory;
+                while (current != null)
+                {
+                    if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                        throw new IOException("Admission evidence ancestry contains a symbolic link.");
+                    current = Path.GetDirectoryName(current);
+                }
+                if (Directory.EnumerateFileSystemEntries(directory).Any())
+                    throw new IOException("Admission evidence directory must be fresh and empty.");
+
+                Texture sampled = evidence.SampledTexture as Texture;
+                Texture attachment = evidence.Attachment.Texture;
+                if (sampled == null || attachment == null)
+                    throw new IOException("Recovered feedback evidence did not contain Metal textures.");
+
+                Dictionary<string, object> record = new()
+                {
+                    ["schema"] = "smash-couch-native-depth-snapshot-admission-rejection-v1",
+                    ["capturedUtc"] = DateTimeOffset.UtcNow,
+                    ["scope"] = "first bounded Main-state depth feedback guard rejection; no draw or policy bypass",
+                    ["program"] = ProgramRecord(program),
+                    ["context"] = context,
+                    ["firstRejectedPredicate"] = firstRejectedPredicate ?? "unknown",
+                    ["guardMessage"] = failure.Message,
+                    ["relation"] = evidence.Relation.ToString(),
+                    ["binding"] = new Dictionary<string, object>
+                    {
+                        ["set"] = evidence.Binding.Set,
+                        ["segmentBinding"] = evidence.Binding.Segment.Binding,
+                        ["segmentCount"] = evidence.Binding.Segment.Count,
+                        ["segmentIsArray"] = evidence.Binding.Segment.IsArray,
+                        ["resourceType"] = evidence.Binding.Segment.Type.ToString(),
+                        ["stages"] = evidence.Binding.Segment.Stages.ToString(),
+                        ["actualBinding"] = evidence.Binding.ActualBinding,
+                        ["groupedOffset"] = evidence.Binding.GroupedOffset,
+                    },
+                    ["sampledTexture"] = new Dictionary<string, object>
+                    {
+                        ["info"] = TextureInfoRecord(sampled.Info),
+                        ["firstLevel"] = sampled.FirstLevel,
+                        ["firstLayer"] = sampled.FirstLayer,
+                        ["feedbackIdentity"] = IdentityRecord(evidence.ShaderIdentity),
+                        ["samplingHandle"] = NativeTextureRecord(sampled.GetHandle()),
+                        ["identityHandle"] = NativeTextureRecord(sampled.GetRenderAttachmentHandle()),
+                    },
+                    ["attachmentTexture"] = new Dictionary<string, object>
+                    {
+                        ["info"] = TextureInfoRecord(attachment.Info),
+                        ["firstLevel"] = attachment.FirstLevel,
+                        ["firstLayer"] = attachment.FirstLayer,
+                        ["feedbackIdentity"] = IdentityRecord(evidence.Attachment.Identity),
+                        ["samplingHandle"] = NativeTextureRecord(attachment.GetHandle()),
+                        ["identityHandle"] = NativeTextureRecord(attachment.GetRenderAttachmentHandle()),
+                    },
+                };
+
+                using FileStream file = new(Path.Combine(directory, "depth-snapshot-admission-rejection.json"),
+                    FileMode.CreateNew, FileAccess.Write, FileShare.None);
+                JsonSerializer.Serialize(file, record, new JsonSerializerOptions { WriteIndented = true });
+                file.Flush(flushToDisk: true);
+            }
+            catch
+            {
+                // Diagnostic failures cannot replace the conservative guard stop.
+            }
+        }
+
+        private static bool IsRecoveredDepthAlias(RenderFeedbackGuard.FailureEvidence evidence) =>
+            evidence.Relation == RenderFeedbackGuard.Relation.PotentialAlias &&
+            evidence.Binding.Set == 2 && evidence.Binding.Segment.Binding == 128 &&
+            evidence.Binding.Segment.Count is (2 or 3) && !evidence.Binding.Segment.IsArray &&
+            evidence.Binding.Segment.Type == Ryujinx.Graphics.GAL.ResourceType.TextureAndSampler &&
+            evidence.Binding.Segment.Stages == Ryujinx.Graphics.GAL.ResourceStages.Fragment &&
+            ((evidence.Binding.ActualBinding == 128 + evidence.Binding.Segment.Count - 1 &&
+              evidence.Binding.GroupedOffset == evidence.Binding.Segment.Count - 1) ||
+             ReadonlyStencil148SnapshotPolicy.MatchesBinding(evidence.Binding)) &&
+            evidence.Attachment.Texture != null &&
+            evidence.Attachment.Role.StartsWith("depth/stencil:", StringComparison.Ordinal);
+
+        internal static Dictionary<string, object> ProgramRecord(Program program)
+        {
+            DepthSnapshotResourceCardinalities counts = program.DepthSnapshotResourceCounts;
+            ReadonlyStencil148ProgramWitness witness = program.ReadonlyStencil148Witness;
+            return new()
+            {
+                ["actualDepthSnapshotShaderAllowed"] = program.DepthSnapshotShaderAllowed,
+                ["resourceSetCount"] = counts.Sets,
+                ["resourceSetCardinalities"] = new[] { counts.Uniforms, counts.Storage, counts.Textures, counts.Images },
+                ["stencil148OptIn"] = ReadonlyStencil148SnapshotPolicy.Enabled,
+                ["stencil148WitnessAllowed"] = witness.Allowed,
+                ["publicReadOnlyFamily"] = witness.PublicReadOnlyFamily,
+                ["actualFamilyAllowed"] = witness.ActualFamilyAllowed,
+                ["exactReviewedSourcePair"] = witness.ExactReviewedPair,
+                ["exactOrderedResources"] = witness.ExactOrderedResources,
+                ["reviewedTransport"] = witness.ReviewedTransport,
+            };
+        }
+
+        private static Dictionary<string, object> TextureInfoRecord(Ryujinx.Graphics.GAL.TextureCreateInfo info) => new()
+        {
+            ["width"] = info.Width,
+            ["height"] = info.Height,
+            ["depth"] = info.Depth,
+            ["levels"] = info.Levels,
+            ["samples"] = info.Samples,
+            ["blockWidth"] = info.BlockWidth,
+            ["blockHeight"] = info.BlockHeight,
+            ["bytesPerPixel"] = info.BytesPerPixel,
+            ["format"] = info.Format.ToString(),
+            ["depthStencilMode"] = info.DepthStencilMode.ToString(),
+            ["target"] = info.Target.ToString(),
+            ["swizzleR"] = info.SwizzleR.ToString(),
+            ["swizzleG"] = info.SwizzleG.ToString(),
+            ["swizzleB"] = info.SwizzleB.ToString(),
+            ["swizzleA"] = info.SwizzleA.ToString(),
+        };
+
+        private static Dictionary<string, object> IdentityRecord(RenderFeedbackGuard.Identity identity) => new()
+        {
+            ["known"] = identity.Known,
+            ["fault"] = identity.Fault,
+            ["view"] = Pointer(identity.View),
+            ["root"] = Pointer(identity.Root),
+            ["buffer"] = Pointer(identity.Buffer),
+            ["gpuResourceId"] = identity.GpuId,
+            ["level"] = identity.Level,
+            ["slice"] = identity.Slice,
+            ["levels"] = identity.Levels,
+            ["layers"] = identity.Layers,
+            ["format"] = identity.Format.ToString(),
+            ["type"] = identity.Type.ToString(),
+        };
+
+        private static Dictionary<string, object> NativeTextureRecord(MTLTexture texture)
+        {
+            Dictionary<string, object> record = new()
+            {
+                ["handle"] = Pointer(texture.NativePtr),
+                ["queried"] = false,
+            };
+            if (texture.NativePtr == IntPtr.Zero) return record;
+
+            try
+            {
+                record["queried"] = true;
+                record["pixelFormat"] = texture.PixelFormat.ToString();
+                record["textureType"] = texture.TextureType.ToString();
+                record["width"] = texture.Width;
+                record["height"] = texture.Height;
+                record["depth"] = texture.Depth;
+                record["sampleCount"] = texture.SampleCount;
+                record["mipmapLevelCount"] = texture.MipmapLevelCount;
+                record["arrayLength"] = texture.ArrayLength;
+                record["storageMode"] = texture.StorageMode.ToString();
+                record["hazardTrackingMode"] = texture.HazardTrackingMode.ToString();
+            }
+            catch (Exception exception)
+            {
+                record["queryFailure"] = $"{exception.GetType().Name}: {exception.Message}";
+            }
+            return record;
+        }
+
+        private static string Pointer(IntPtr value) => $"0x{(ulong)value:X}";
+    }
+}
diff --git a/src/Ryujinx.Graphics.Metal/DepthSnapshotExtent.cs b/src/Ryujinx.Graphics.Metal/DepthSnapshotExtent.cs
new file mode 100644
index 0000000000000000000000000000000000000000..4ef4b823128baceb7f8c00b07f171bb3d1e496f7
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/DepthSnapshotExtent.cs
@@ -0,0 +1,71 @@
+using SharpMetal.Metal;
+using System;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // The snapshot may use any actual positive guest extent up to the existing
+    // conservative bound. All byte counts are checked before this value can be
+    // used for native allocation or a depth/stencil blit.
+    internal readonly struct DepthSnapshotExtent
+    {
+        private const MTLStorageMode MemorylessStorage = (MTLStorageMode)3;
+        private const MTLHazardTrackingMode TrackedHazards = (MTLHazardTrackingMode)2;
+        internal const int MaximumWidth = 1920;
+        internal const int MaximumHeight = 1080;
+        internal const int NativeDepthStencilBytesPerPixel = 8;
+
+        internal int Width { get; }
+        internal int Height { get; }
+        internal long PixelCount { get; }
+        internal long GuestBytes { get; }
+        internal long NativeBytes { get; }
+
+        private DepthSnapshotExtent(int width, int height, long pixelCount,
+            long guestBytes, long nativeBytes)
+        {
+            Width = width;
+            Height = height;
+            PixelCount = pixelCount;
+            GuestBytes = guestBytes;
+            NativeBytes = nativeBytes;
+        }
+
+        internal static bool TryCreate(int width, int height, int guestBytesPerPixel,
+            out DepthSnapshotExtent extent)
+        {
+            extent = default;
+            if (width <= 0 || height <= 0 || guestBytesPerPixel <= 0)
+                return false;
+
+            long pixels;
+            long guestBytes;
+            long nativeBytes;
+            try
+            {
+                pixels = checked((long)width * height);
+                guestBytes = checked(pixels * guestBytesPerPixel);
+                nativeBytes = checked(pixels * NativeDepthStencilBytesPerPixel);
+            }
+            catch (OverflowException)
+            {
+                return false;
+            }
+
+            if (width > MaximumWidth || height > MaximumHeight)
+                return false;
+
+            extent = new(width, height, pixels, guestBytes, nativeBytes);
+            return true;
+        }
+
+        internal bool MatchesNativeExtent(ulong width, ulong height) =>
+            width == (ulong)Width && height == (ulong)Height;
+
+        internal bool MatchesNativeDepthTexture(MTLTexture texture, MTLPixelFormat pixelFormat) =>
+            texture.NativePtr != IntPtr.Zero && texture.PixelFormat == pixelFormat &&
+            texture.TextureType == MTLTextureType.Type2D &&
+            MatchesNativeExtent(texture.Width, texture.Height) && texture.Depth == 1 &&
+            texture.SampleCount == 1 && texture.MipmapLevelCount == 1 && texture.ArrayLength == 1 &&
+            texture.StorageMode != MemorylessStorage && texture.HazardTrackingMode == TrackedHazards;
+    }
+}
diff --git a/src/Ryujinx.Graphics.Metal/DepthSnapshotProgramPolicy.cs b/src/Ryujinx.Graphics.Metal/DepthSnapshotProgramPolicy.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1ae6ea7e94d7feed8316c49d20a6547dd2007e0e
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/DepthSnapshotProgramPolicy.cs
@@ -0,0 +1,80 @@
+using Ryujinx.Graphics.GAL;
+using Ryujinx.Graphics.Shader;
+using Ryujinx.Graphics.Shader.Translation;
+using System;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // Active resource usages drive the Metal argument-buffer layout. Uniform
+    // buffer positions do not determine whether a sampled depth texture aliases
+    // an attachment. Admit bounded, scalar, read-only uniform layouts and the
+    // vertex and fragment scalar texture capacities. Runtime attachment identity,
+    // copy and full feedback checks remain mandatory. Do not use ResourceUsage.Equals:
+    // its upstream implementation does not compare the Write property.
+    internal static class DepthSnapshotProgramPolicy
+    {
+        internal static bool Allows(ShaderSource[] shaders, ResourceLayout layout)
+        {
+            if (shaders == null || shaders.Length != 2 ||
+                shaders[0].Stage != ShaderStage.Vertex || shaders[1].Stage != ShaderStage.Fragment ||
+                shaders[0].Language != TargetLanguage.Msl || shaders[1].Language != TargetLanguage.Msl ||
+                string.IsNullOrWhiteSpace(shaders[0].Code) || string.IsNullOrWhiteSpace(shaders[1].Code) ||
+                layout.SetUsages == null || layout.SetUsages.Count != 4)
+                return false;
+
+            for (int set = 0; set < 4; set++)
+                if (layout.SetUsages[set].Usages == null) return false;
+            if (layout.SetUsages[0].Usages.Count is < 1 or > Constants.MaxUniformBufferBindings ||
+                layout.SetUsages[1].Usages.Count != 0 ||
+                layout.SetUsages[2].Usages.Count is < 1 or > 2 * Constants.MaxTexturesPerStage ||
+                layout.SetUsages[3].Usages.Count != 0)
+                return false;
+
+            int previousBinding = -1;
+            foreach (ResourceUsage usage in layout.SetUsages[0].Usages)
+            {
+                if (usage.Binding <= previousBinding || usage.Binding >= Constants.MaxUniformBufferBindings ||
+                    usage.ArrayLength != 1 || usage.Type != ResourceType.UniformBuffer || usage.Write ||
+                    ((usage.Stages & ResourceStages.Compute) != 0 && usage.Binding != 0) ||
+                    !AllowsUniformStages(usage.Stages)) return false;
+                previousBinding = usage.Binding;
+            }
+            int vertexCount = 0;
+            int fragmentCount = 0;
+            bool sawFragment = false;
+            foreach (ResourceUsage usage in layout.SetUsages[2].Usages)
+            {
+                if (usage.Stages == ResourceStages.Vertex && !sawFragment)
+                {
+                    if (vertexCount >= Constants.MaxTexturesPerStage ||
+                        !Matches(usage, vertexCount++, ResourceType.TextureAndSampler, ResourceStages.Vertex))
+                        return false;
+                }
+                else if (usage.Stages == ResourceStages.Fragment)
+                {
+                    sawFragment = true;
+                    if (fragmentCount >= Constants.MaxTexturesPerStage ||
+                        !Matches(usage, 128 + fragmentCount++, ResourceType.TextureAndSampler, ResourceStages.Fragment))
+                        return false;
+                }
+                else return false;
+            }
+            return true;
+        }
+
+        internal static bool AllowsUniformStages(ResourceStages stages)
+        {
+            const ResourceStages graphics = ResourceStages.Vertex | ResourceStages.Fragment;
+            const ResourceStages allowed = graphics | ResourceStages.Compute;
+            // The shared support UBO includes Compute in its stage mask even for
+            // a vertex/fragment program. A compute-only or unsupported stage is
+            // outside this contract.
+            return (stages & graphics) != 0 && (stages & ~allowed) == 0;
+        }
+
+        private static bool Matches(ResourceUsage usage, int binding,
+            ResourceType type, ResourceStages stages) =>
+            usage.Binding == binding && usage.ArrayLength == 1 &&
+            usage.Type == type && usage.Stages == stages && !usage.Write;
+    }
+}
diff --git a/src/Ryujinx.Graphics.Metal/DepthSnapshotSuccessEvidence.cs b/src/Ryujinx.Graphics.Metal/DepthSnapshotSuccessEvidence.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b2b2564d021ea92584bbcdf3bfe75da03d1dda6d
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/DepthSnapshotSuccessEvidence.cs
@@ -0,0 +1,133 @@
+using Ryujinx.Common.Logging;
+using Ryujinx.Graphics.Metal.State;
+using SharpMetal.Metal;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using System.Threading;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // Opt-in, one-shot, private success marker. It proves only that an admitted
+    // native draw command was encoded after the copy and state rebind, not that
+    // its GPU execution completed or that game presentation was correct.
+    internal static class DepthSnapshotSuccessEvidence
+    {
+        private const string Variable = "SMASH_COUCH_DEPTH_SNAPSHOT_EVIDENCE_DIR";
+        private static int _claimed;
+        internal static bool Pending => Volatile.Read(ref _claimed) == 0 &&
+            !string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable(Variable));
+
+        internal static void TryWrite(string context, RenderFeedbackGuard.Identity source,
+            RenderFeedbackGuard.Identity snapshot, RenderFeedbackGuard.Identity attachment,
+            IntPtr commandBuffer, DepthStencilUid requested, DepthStencilUid effective,
+            EncoderType encoder, Program program, RenderFeedbackGuard.BindingEvidence binding,
+            bool readonlyStencil148, int frontReference, int backReference)
+        {
+            string configured = Environment.GetEnvironmentVariable(Variable);
+            if (string.IsNullOrWhiteSpace(configured) ||
+                Interlocked.CompareExchange(ref _claimed, 1, 0) != 0) return;
+
+            try
+            {
+                string directory = Path.GetFullPath(configured);
+                string lab = Path.GetFullPath(Path.Combine(
+                    Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
+                    "Library", "Application Support", "Smash Couch", "Lab"));
+                string prefix = lab + Path.DirectorySeparatorChar;
+                string[] arguments = Environment.GetCommandLineArgs();
+                int dataSwitch = Array.IndexOf(arguments, "-r");
+                if (dataSwitch < 0 || dataSwitch + 1 >= arguments.Length)
+                    throw new IOException("Snapshot evidence requires the actual private -r data path.");
+                string data = Path.GetFullPath(arguments[dataSwitch + 1]);
+                if (!directory.StartsWith(prefix, StringComparison.Ordinal) ||
+                    !data.StartsWith(prefix, StringComparison.Ordinal) ||
+                    !directory.StartsWith(data + Path.DirectorySeparatorChar, StringComparison.Ordinal) ||
+                    !Directory.Exists(directory) ||
+                    !Directory.Exists(lab) || !Directory.Exists(data))
+                    throw new IOException("Snapshot evidence must be a preexisting private Lab child directory.");
+
+                string current = directory;
+                while (current != null)
+                {
+                    if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                        throw new IOException("Snapshot evidence ancestry contains a symbolic link.");
+                    current = Path.GetDirectoryName(current);
+                }
+                if (Directory.EnumerateFileSystemEntries(directory).Any())
+                    throw new IOException("Snapshot evidence directory must be fresh and empty.");
+
+                Dictionary<string, object> record = new()
+                {
+                    ["schema"] = "smash-couch-native-depth-snapshot-first-encoded-v1",
+                    ["capturedUtc"] = DateTimeOffset.UtcNow,
+                    ["scope"] = "first admitted native Draw command encoded; GPU completion and image correctness unproven",
+                    ["context"] = context,
+                    ["admittedCase"] = readonlyStencil148 ? "readonly-stencil148" : "existing-less-equal-stencil-disabled",
+                    ["program"] = DepthSnapshotAdmissionEvidence.ProgramRecord(program),
+                    ["binding"] = new Dictionary<string, object>
+                    {
+                        ["set"] = binding.Set,
+                        ["segmentBinding"] = binding.Segment.Binding,
+                        ["segmentCount"] = binding.Segment.Count,
+                        ["segmentIsArray"] = binding.Segment.IsArray,
+                        ["resourceType"] = binding.Segment.Type.ToString(),
+                        ["stages"] = binding.Segment.Stages.ToString(),
+                        ["actualBinding"] = binding.ActualBinding,
+                        ["groupedOffset"] = binding.GroupedOffset,
+                    },
+                    ["nativeIdentityShapeCopyChecksCompleted"] = true,
+                    ["frontReference"] = frontReference,
+                    ["backReference"] = backReference,
+                    ["frontStencil"] = FaceRecord(requested.FrontFace),
+                    ["backStencil"] = FaceRecord(requested.BackFace),
+                    ["encoderAfterEncoding"] = encoder.ToString(),
+                    ["commandBuffer"] = $"0x{commandBuffer.ToInt64():X}",
+                    ["sourceView"] = $"0x{source.View.ToInt64():X}",
+                    ["sourceRoot"] = $"0x{source.Root.ToInt64():X}",
+                    ["sourceLevel"] = source.Level,
+                    ["sourceSlice"] = source.Slice,
+                    ["snapshotView"] = $"0x{snapshot.View.ToInt64():X}",
+                    ["snapshotRoot"] = $"0x{snapshot.Root.ToInt64():X}",
+                    ["snapshotGpuResourceId"] = snapshot.GpuId,
+                    ["attachmentView"] = $"0x{attachment.View.ToInt64():X}",
+                    ["attachmentRoot"] = $"0x{attachment.Root.ToInt64():X}",
+                    ["requestedDepthCompare"] = requested.DepthCompareFunction.ToString(),
+                    ["effectiveDepthCompare"] = effective.DepthCompareFunction.ToString(),
+                    ["requestedDepthWriteEnabled"] = requested.DepthWriteEnabled,
+                    ["effectiveDepthWriteEnabled"] = effective.DepthWriteEnabled,
+                    ["requestedStencilTestEnabled"] = requested.StencilTestEnabled,
+                    ["effectiveStencilTestEnabled"] = effective.StencilTestEnabled,
+                    ["copyOrder"] = "same tracked command buffer: prior render Store, full D32S8 blit, blit End, render Load, Draw encoded",
+                };
+                using FileStream file = new(Path.Combine(directory, "first-depth-snapshot-encoded.json"),
+                    FileMode.CreateNew, FileAccess.Write, FileShare.None);
+                JsonSerializer.Serialize(file, record);
+                file.Flush(flushToDisk: true);
+            }
+            catch (Exception failure)
+            {
+                // Diagnostic errors cannot change the draw's rendering result
+                // or replace an exception from the actual render path.
+                try
+                {
+                    Logger.Error?.PrintMsg(LogClass.Gpu,
+                        $"[CouchNativeDepthSnapshot] first-encoded evidence failed: {failure.GetType().Name}: {failure.Message}");
+                }
+                catch { }
+            }
+        }
+
+        private static Dictionary<string, object> FaceRecord(StencilUid face) => new()
+        {
+            ["compare"] = face.StencilCompareFunction.ToString(),
+            ["readMask"] = face.ReadMask,
+            ["writeMask"] = face.WriteMask,
+            ["stencilFailureOperation"] = face.StencilFailureOperation.ToString(),
+            ["depthFailureOperation"] = face.DepthFailureOperation.ToString(),
+            ["depthStencilPassOperation"] = face.DepthStencilPassOperation.ToString(),
+        };
+    }
+}
diff --git a/src/Ryujinx.Graphics.Metal/DepthSnapshotTextureInfoPolicy.cs b/src/Ryujinx.Graphics.Metal/DepthSnapshotTextureInfoPolicy.cs
new file mode 100644
index 0000000000000000000000000000000000000000..beb8d79066247fed62a81895368f6568ec91c8c5
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/DepthSnapshotTextureInfoPolicy.cs
@@ -0,0 +1,40 @@
+using Ryujinx.Graphics.GAL;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // Keep the guest attachment allocation shape exact while allowing only the
+    // sampled-view swizzles used by the existing fixture and Metal depth pool.
+    internal static class DepthSnapshotTextureInfoPolicy
+    {
+        internal static bool SameAllocationShape(TextureCreateInfo attachment, TextureCreateInfo sampled)
+        {
+            return attachment.Width == sampled.Width &&
+                   attachment.Height == sampled.Height &&
+                   attachment.Depth == sampled.Depth &&
+                   attachment.Levels == sampled.Levels &&
+                   attachment.Samples == sampled.Samples &&
+                   attachment.BlockWidth == sampled.BlockWidth &&
+                   attachment.BlockHeight == sampled.BlockHeight &&
+                   attachment.BytesPerPixel == sampled.BytesPerPixel &&
+                   attachment.Format == sampled.Format &&
+                   attachment.DepthStencilMode == sampled.DepthStencilMode &&
+                   attachment.Target == sampled.Target;
+        }
+
+        internal static bool HasIdentitySwizzle(TextureCreateInfo info) =>
+            info.SwizzleR == SwizzleComponent.Red &&
+            info.SwizzleG == SwizzleComponent.Green &&
+            info.SwizzleB == SwizzleComponent.Blue &&
+            info.SwizzleA == SwizzleComponent.Alpha;
+
+        internal static bool HasCanonicalDepthSwizzle(TextureCreateInfo info) =>
+            info.DepthStencilMode == DepthStencilMode.Depth &&
+            info.SwizzleR == SwizzleComponent.Red &&
+            info.SwizzleG == SwizzleComponent.Red &&
+            info.SwizzleB == SwizzleComponent.Red &&
+            info.SwizzleA == SwizzleComponent.One;
+
+        internal static bool HasAdmittedSampleSwizzle(TextureCreateInfo info) =>
+            HasIdentitySwizzle(info) || HasCanonicalDepthSwizzle(info);
+    }
+}
