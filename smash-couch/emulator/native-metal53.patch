+
+        internal static Dictionary<string, object> EmittedSlot(int slot, int logicalBinding,
+            int? arrayIndex, string resourceKind, ulong gpuResourceId) => new()
+        {
+            ["slotIndex"] = slot,
+            ["logicalBinding"] = logicalBinding,
+            ["arrayIndex"] = arrayIndex,
