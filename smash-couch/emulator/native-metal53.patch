+                $"originalVertex={Sha(sources[vi].Code)} originalFragment={Sha(sources[fi].Code)} " +
+                $"adaptedVertex={Sha(rewritten.Vertex)} adaptedFragment={Sha(rewritten.Fragment)} exits={exits} " +
