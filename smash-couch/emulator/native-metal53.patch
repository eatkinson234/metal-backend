diff --git a/src/Ryujinx.HLE/HOS/Services/Nv/NvDrvServices/NvHostCtrl/Types/NvCpuWaitReservation.cs b/src/Ryujinx.HLE/HOS/Services/Nv/NvDrvServices/NvHostCtrl/Types/NvCpuWaitReservation.cs
new file mode 100644
index 0000000000000000000000000000000000000000..2e333b0ccf9c9f93c7715144b398cbba4ab0d4ac
--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/Nv/NvDrvServices/NvHostCtrl/Types/NvCpuWaitReservation.cs
@@ -0,0 +1,27 @@
+using Ryujinx.HLE.HOS.Services.Nv.Types;
+using System.Threading;
+
+namespace Ryujinx.HLE.HOS.Services.Nv.NvDrvServices.NvHostCtrl
+{
+    enum NvHostWaitPreparation
+    {
+        Queued,
+        CpuFallback,
+    }
+
+    sealed class NvCpuWaitReservation
+    {
+        public readonly NvFence Fence;
+        public readonly ulong Generation;
+        private int _cancelled;
+
+        public NvCpuWaitReservation(NvFence fence, ulong generation)
+        {
+            Fence = fence;
+            Generation = generation;
+        }
+
+        public bool IsCancelled => Volatile.Read(ref _cancelled) != 0;
+        public void Cancel() => Interlocked.Exchange(ref _cancelled, 1);
+    }
+}
