+        /// <summary>
+        /// Redoes a read the invalid access handler allowed to continue, one page at a time: mapped pages are read,
+        /// and pages that are unmapped or outside the address space read as zeros. The first attempt stopped at the
+        /// first such page, which would leave any mapped pages after it unread.
+        /// </summary>
+        private void ReadMappedPages(ulong va, Span<byte> data)
+        {
+            int offset = 0;
+
+            while (offset < data.Length)
+            {
+                ulong pageVa = va + (ulong)offset;
+                int size = Math.Min(data.Length - offset, PageSize - (int)(pageVa & PageMask));
+                Span<byte> page = data.Slice(offset, size);
+
+                if (pageVa < va || !IsMapped(pageVa))
+                {
+                    page.Clear();
+                }
+                else
+                {
+                    try
+                    {
+                        base.Read(pageVa, page);
+                    }
+                    catch (InvalidMemoryRegionException)
+                    {
+                        page.Clear(); // Unmapped since the check.
+                    }
+                }
+
+                offset += size;
+            }
+        }
+
+        /// <summary>
+        /// Redoes a write the invalid access handler allowed to continue, one page at a time: mapped pages are
+        /// written, and data for pages that are unmapped or outside the address space is dropped.
+        /// </summary>
+        private void WriteMappedPages(ulong va, ReadOnlySpan<byte> data, bool tracked)
+        {
+            int offset = 0;
+
+            while (offset < data.Length)
+            {
+                ulong pageVa = va + (ulong)offset;
+                int size = Math.Min(data.Length - offset, PageSize - (int)(pageVa & PageMask));
+
+                if (pageVa >= va && IsMapped(pageVa))
+                {
+                    try
+                    {
+                        if (tracked)
+                        {
+                            base.Write(pageVa, data.Slice(offset, size));
+                        }
+                        else
+                        {
+                            base.WriteUntracked(pageVa, data.Slice(offset, size));
+                        }
+                    }
+                    catch (InvalidMemoryRegionException)
+                    {
+                        // Unmapped since the check; dropped like the other unmapped pages.
+                    }
+                }
+
+                offset += size;
             }
         }
 
