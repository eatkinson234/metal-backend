new file mode 100644
index 0000000..d956103
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/FrameSnapshot.cs
@@ -0,0 +1,101 @@
+using Ryujinx.Graphics.GAL;
+using System;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Runtime.Versioning;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // Overnight diagnostic: on request, write the guest frame being presented so an
+    // unattended runner can verify which screen is showing without screen recording.
+    // Off unless SMASH_COUCH_SNAPSHOT_DIR names an existing directory inside
+    // SMASH_COUCH_PRIVATE_DATA. A request is the file "request" containing a label.
+    [SupportedOSPlatform("macos")]
+    static class FrameSnapshot
+    {
+        private static readonly string _dir = ValidateDirectory();
+        private static int _frames;
+
+        private static string ValidateDirectory()
+        {
+            string dir = Environment.GetEnvironmentVariable("SMASH_COUCH_SNAPSHOT_DIR");
+            string root = Environment.GetEnvironmentVariable("SMASH_COUCH_PRIVATE_DATA");
+            try
+            {
+                if (string.IsNullOrEmpty(dir) || string.IsNullOrEmpty(root) || !Path.IsPathFullyQualified(dir) || !Directory.Exists(dir))
+                {
+                    return null;
+                }
+
+                // Compare resolved locations so a symlink cannot lead outside the private data root.
+                string real = Path.GetFullPath(new DirectoryInfo(dir).ResolveLinkTarget(true)?.FullName ?? dir);
+                string realRoot = Path.GetFullPath(new DirectoryInfo(root).ResolveLinkTarget(true)?.FullName ?? root);
+                return real == Path.GetFullPath(dir) && real.StartsWith(realRoot.TrimEnd('/') + "/", StringComparison.Ordinal) ? real : null;
+            }
+            catch (Exception)
+            {
+                return null;
+            }
+        }
+
+        public static void TryCapture(Texture texture)
+        {
+            // Checking for a request every 15 frames costs one stat four times a second.
+            if (_dir == null || ++_frames % 15 != 0)
+            {
+                return;
+            }
+
+            string request = Path.Combine(_dir, "request");
+            string label;
+            try
+            {
+                if (!File.Exists(request))
+                {
+                    return;
+                }
+
+                label = File.ReadAllText(request).Trim();
+                File.Delete(request);
+            }
+            catch (Exception)
+            {
+                return;
+            }
+
+            if (label.Length == 0 || label.Length > 64 || !label.All(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_'))
+            {
+                label = "snapshot";
+            }
+
+            // A diagnostic must never take down the render thread; failures are recorded instead.
+            try
+            {
+                long started = Stopwatch.GetTimestamp();
+                using PinnedSpan<byte> data = texture.GetData(0, 0);
+                ReadOnlySpan<byte> bytes = data.Get();
+                using (FileStream file = new(Path.Combine(_dir, label + ".raw"), FileMode.CreateNew, FileAccess.Write))
+                {
+                    file.Write(bytes);
+                }
+
+                File.WriteAllText(Path.Combine(_dir, label + ".json"), string.Create(CultureInfo.InvariantCulture,
+                    $"{{\"width\":{texture.Width},\"height\":{texture.Height},\"format\":\"{texture.Info.Format}\"," +
+                    $"\"bytes\":{bytes.Length},\"stopwatch_ticks\":{started},\"capture_ms\":" +
+                    $"{(Stopwatch.GetTimestamp() - started) * 1000.0 / Stopwatch.Frequency:F3}}}"));
+            }
+            catch (Exception error)
+            {
+                try
+                {
+                    File.WriteAllText(Path.Combine(_dir, label + ".error"), error.ToString());
+                }
+                catch (Exception)
+                {
+                }
+            }
+        }
+    }
+}
diff --git a/source58/src/Ryujinx.Graphics.Metal/ManagedMemoryDiagnostics.cs b/src/Ryujinx.Graphics.Metal/ManagedMemoryDiagnostics.cs
new file mode 100644
index 0000000..b21686c
--- /dev/null
+++ b/src/Ryujinx.Graphics.Metal/ManagedMemoryDiagnostics.cs
@@ -0,0 +1,73 @@
+using Ryujinx.Common.Logging;
+using System;
+using System.Globalization;
+using System.Text;
+
+namespace Ryujinx.Graphics.Metal
+{
+    // Managed heap figures for long sessions. The launcher caps the managed
+    // heap (DOTNET_GCHeapHardLimit) separately from the sampled process
+    // footprint, and a managed OutOfMemoryException ends the game, so the
+    // footprint alone cannot show how close a session is to that cap. Logged
+    // with the periodic summaries: what the last GC saw, per generation, plus
+    // the allocator's running totals. Diagnostics only; never throws.
+    static class ManagedMemoryDiagnostics
+    {
+        private const long MiB = 1024 * 1024;
+        private static readonly string[] _generationNames = ["gen0", "gen1", "gen2", "loh", "poh"];
+
+        internal static string Summary()
+        {
+            GCMemoryInfo info = GC.GetGCMemoryInfo(GCKind.Any);
+            StringBuilder text = new("ManagedMemory: ");
+            text.Append("heapMiB=").Append(info.HeapSizeBytes / MiB);
+            text.Append(";fragmentedMiB=").Append(info.FragmentedBytes / MiB);
+            text.Append(";committedMiB=").Append(info.TotalCommittedBytes / MiB);
+            text.Append(";limitMiB=").Append(info.TotalAvailableMemoryBytes / MiB);
+            text.Append(";loadMiB=").Append(info.MemoryLoadBytes / MiB);
+            text.Append(";highLoadMiB=").Append(info.HighMemoryLoadThresholdBytes / MiB);
+            text.Append(";promotedMiB=").Append(info.PromotedBytes / MiB);
+            text.Append(";pinned=").Append(info.PinnedObjectsCount);
+            ReadOnlySpan<GCGenerationInfo> generations = info.GenerationInfo;
+            for (int index = 0; index < generations.Length && index < _generationNames.Length; index++)
+            {
+                text.Append(';').Append(_generationNames[index]).Append("MiB=").Append(generations[index].SizeAfterBytes / MiB);
+            }
+            text.Append(";liveMiB=").Append(GC.GetTotalMemory(false) / MiB);
+            text.Append(";allocatedMiB=").Append(GC.GetTotalAllocatedBytes(false) / MiB);
+            text.Append(";gcs=").Append(GC.CollectionCount(0)).Append('/').Append(GC.CollectionCount(1)).Append('/').Append(GC.CollectionCount(2));
+            text.Append(";lastGc=").Append(info.Index).Append(":gen").Append(info.Generation).Append(info.Compacted ? ":compacted" : ":swept");
+            // Pause time: the running total since start (per-interval deltas come from consecutive lines), the last
+            // collection's pauses, and the last full blocking collection, which is the one that can stall a frame.
+            text.Append(";gcPauseMs=").Append((long)GC.GetTotalPauseDuration().TotalMilliseconds);
+            text.Append(";lastPauseMs=").Append(PauseMilliseconds(info).ToString("F1", CultureInfo.InvariantCulture));
+            GCMemoryInfo blocking = GC.GetGCMemoryInfo(GCKind.FullBlocking);
+            text.Append(";lastBlockingGc=").Append(blocking.Index).Append(':')
+                .Append(PauseMilliseconds(blocking).ToString("F1", CultureInfo.InvariantCulture)).Append("ms");
+            return text.ToString();
+        }
+
+        private static double PauseMilliseconds(GCMemoryInfo info)
+        {
+            double total = 0;
+            foreach (TimeSpan pause in info.PauseDurations)
+            {
+                total += pause.TotalMilliseconds;
+            }
+
+            return total;
+        }
+
+        internal static void Log(string reason)
+        {
+            try
+            {
+                Logger.Info?.Print(LogClass.Gpu, $"{Summary()};reason={reason}");
+            }
+            catch (Exception)
+            {
+                // A diagnostics failure must not reach the caller.
+            }
+        }
+    }
+}
